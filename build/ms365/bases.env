# The base-image build-args of build/ms365/Dockerfile, each mapped to its
# upstream ref. scripts/build.sh replaces each with our digest-pinned mirror
# and refuses to build if a ref is not in images.tsv.
#
# Node 24 on Alpine, the base upstream's own Dockerfile names, for the build
# and the runtime alike.
NODE_IMAGE=node:24-alpine
