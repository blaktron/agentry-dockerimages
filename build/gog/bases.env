# The base-image build-args of build/gog/Dockerfile, each mapped to its
# upstream ref. scripts/build.sh replaces each with our digest-pinned mirror
# and refuses to build if a ref is not in images.tsv.
#
# The Go and Alpine 3.23 mirrors build/docker-agent/ uses. gog is built with
# CGO off, so the binary links nothing from the builder's musl.
GO_IMAGE=golang:1.27.3-alpine3.23
ALPINE_IMAGE=alpine:3.23
