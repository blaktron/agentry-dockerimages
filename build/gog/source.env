UPSTREAM_REPO=https://github.com/openclaw/gogcli
UPSTREAM_COMMIT=cbb7f01f76fa8a815aec4b21b64395d87e454bbb
UPSTREAM_TAG=v0.47.1
UPSTREAM_LICENSE=MIT
# gog, the Google Workspace CLI whose `gog mcp` mode serves Gmail, Calendar,
# Drive, Docs and Sheets as MCP tools. Built from source rather than mirrored:
# the project's own image is amd64 only and unsigned, and its Linux release
# binaries carry checksums and no signature, so the bytes a person runs are
# the ones this build makes from the pinned commit and signs.
#
# Built natively per architecture (PLATFORM=linux/amd64, PLATFORM=linux/arm64)
# and joined into one tag by scripts/build.sh --merge; the gog workflow does
# both, then signs the joined digest. The tag is the upstream version, the
# build date and the workflow's run number, passed as IMAGE_TAG
# (0.47.1-2026.10.30.1), and the workflow refuses a tag that exists, so a
# rebuild is a new tag and a new digest, never an overwrite.
IMAGE_NAME=agentry-gog
PLATFORMS=linux/amd64,linux/arm64
