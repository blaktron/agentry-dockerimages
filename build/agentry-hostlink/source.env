# Built from this directory, not from an upstream repository: the host link
# image is Alpine with the OpenSSH client, and nothing else.
#
# Built natively per architecture (PLATFORM=linux/amd64, PLATFORM=linux/arm64)
# and joined into one tag by scripts/build.sh --merge; the hostlink workflow
# does both, then signs the joined digest. The tag is the build date and the
# workflow's run number, passed as IMAGE_TAG, and the workflow refuses a tag
# that exists, so a rebuild is a new tag and a new digest, never an overwrite.
IMAGE_NAME=agentry-hostlink
PLATFORMS=linux/amd64,linux/arm64
