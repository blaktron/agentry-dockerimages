# The base-image build-arg of build/agentry-hostlink/Dockerfile, mapped to its
# upstream ref. scripts/build.sh replaces it with our digest-pinned mirror and
# refuses to build if the ref is not in images.tsv. It is the runner image's
# own runtime base, so the OpenSSH client and the runner binary the CLI adds
# on top share one musl, as in the files image.
ALPINE_IMAGE=alpine:3.24
