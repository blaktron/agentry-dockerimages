# Built from this directory, not from an upstream repository: the image is a
# Kali base with two data files of ours (plan unsafe-mode.md §4.1).
#
# Built natively per architecture (PLATFORM=linux/amd64, PLATFORM=linux/arm64)
# and joined into one tag by scripts/build.sh --merge; the unsafe-kali
# workflow does both. The tag is the build date, passed as IMAGE_TAG, so a
# monthly rebuild (D10) is a new tag and a new digest, never an overwrite.
IMAGE_NAME=agentry-unsafe-kali
PLATFORMS=linux/amd64,linux/arm64
