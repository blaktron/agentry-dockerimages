# Built from this directory, not from an upstream repository: the image is a
# Kali base with the data files of ours under /etc/agentry/unsafe/ (plan
# unsafe-mode.md §4.1).
#
# Built natively per architecture (PLATFORM=linux/amd64, PLATFORM=linux/arm64)
# and joined into one tag by scripts/build.sh --merge; the unsafe-kali
# workflow does both. The tag is the build date and the workflow's run
# number, passed as IMAGE_TAG, and the workflow refuses a tag that exists, so
# a rebuild (D10) is a new tag and a new digest, never an overwrite.
IMAGE_NAME=agentry-unsafe-kali
PLATFORMS=linux/amd64,linux/arm64
