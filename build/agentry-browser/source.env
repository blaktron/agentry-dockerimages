# The browser server image: Microsoft's @playwright/mcp and Debian's Chromium,
# on our debian:trixie-slim mirror. Nothing is compiled here.
#
# The server is pinned by package-lock.json (an exact version, integrity
# hashes, installed with --ignore-scripts). The browser is Debian's chromium
# package, built by Debian from the Chromium project's open-source code, at
# CHROMIUM_DEB_VERSION, from snapshot.debian.org at DEBIAN_SNAPSHOT, with
# chromium and chromium-common held to their SHA-256 per architecture; every
# other package install.sh installs comes from that same snapshot, whose
# three signed indexes are held to their SHA-256 too. The build fails unless
# the indexes and the downloaded packages match, and unless the lockfile's
# Playwright was made for this Chromium's major version or the next
# (install.sh).
#
# A bump is by hand (README, "agentry-browser"): a new version in
# package.json and `npm install --package-lock-only --ignore-scripts`; then a
# snapshot timestamp whose trixie-security (or trixie) holds a chromium for
# the Chromium major version the new browsers.json names, or the one before
# it, that package's version, the SHA-256s the snapshot's binary-amd64 and
# binary-arm64 Packages indexes (of the suite that holds it) give for
# chromium and chromium-common, and the SHA-256 of each suite's InRelease at
# that snapshot.
MCP_VERSION=0.0.83
PLAYWRIGHT_VERSION=1.64.0-alpha-1790635538000
CHROMIUM_VERSION=155.0.8059.79
CHROMIUM_DEB_VERSION=155.0.8059.79-1~deb13u1
DEBIAN_SNAPSHOT=20261022T000000Z
# SHA-256 of dists/<suite>/InRelease at DEBIAN_SNAPSHOT (debian-security for
# trixie-security).
DEBIAN_INDEX_SHA256_TRIXIE=0584fba32e13e0ab8285fb16c27adea1ec03a73669c18702821094fd6ca86675
DEBIAN_INDEX_SHA256_TRIXIE_UPDATES=546faff09befe9aff38c74cf8c21ced39aba9a90555f919f6e2f9e5368313922
DEBIAN_INDEX_SHA256_TRIXIE_SECURITY=ebc037ef479e20ff279abbe69854c12d14d6dd384c623555610d2bfb7bb90187
# SHA-256 of chromium_<CHROMIUM_DEB_VERSION>_<arch>.deb and
# chromium-common_<CHROMIUM_DEB_VERSION>_<arch>.deb, from the snapshot's
# trixie-security Packages indexes.
CHROMIUM_SHA256_AMD64=f52c20eb7eec8f52e421f2384c0ef1920aacea92967e289ba1838570fa6bbcac
CHROMIUM_SHA256_ARM64=bb4334a065801d7482df4783b535ab16654fb71e6eac8a89bd49eb2e7082be27
CHROMIUM_COMMON_SHA256_AMD64=3ea439a3991cac4ebc9741484bf93f848327bdd413b78853bb025454f419f9a6
CHROMIUM_COMMON_SHA256_ARM64=2f8d97e652adc2afa8cc96f79141ffdff0ca4f11c3a35671e7b61f60d10eb2b5
# Built natively per architecture (PLATFORM=linux/amd64, PLATFORM=linux/arm64)
# and joined into one tag by scripts/build.sh --merge; the browser workflow
# does both, then signs the joined digest. The tag is the build date and the
# workflow's run number, passed as IMAGE_TAG, and the workflow refuses a tag
# that exists, so a rebuild is a new tag and a new digest, never an overwrite.
IMAGE_NAME=agentry-browser
PLATFORMS=linux/amd64,linux/arm64
