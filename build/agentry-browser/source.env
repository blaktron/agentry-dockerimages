# The browser server image: Microsoft's @playwright/mcp and the Chrome for
# Testing build of the Playwright it pins, on our ubuntu:noble mirror
# (agentry-dockerimages#82; agentry-notes plans/browser-testing.md §4, §7, D5,
# D14; M1's findings on agentry-cli#914). Nothing is compiled here.
#
# The server is pinned by package-lock.json (an exact version, integrity
# hashes, installed with --ignore-scripts). The browser is the Chrome for
# Testing build that the lockfile's playwright-core names in browsers.json, a
# revision and a version, downloaded from Google's own Chrome for Testing
# bucket and held to a SHA-256 per architecture; the build fails unless
# browsers.json and these agree, and unless each archive matches.
#
# A bump is by hand (README, "The browser image"): a new version in
# package.json, `npm install --package-lock-only --ignore-scripts`, then the
# revision and version browsers.json now names and the SHA-256 of each
# architecture's chrome-linux*.zip at that version. Google stores an MD5 of
# each archive (x-goog-hash); check the download against it before taking its
# SHA-256.
MCP_VERSION=0.0.83
PLAYWRIGHT_VERSION=1.64.0-alpha-1790635538000
CHROMIUM_REVISION=1247
CHROMIUM_VERSION=155.0.8059.12
CHROMIUM_URL=https://storage.googleapis.com/chrome-for-testing-public
# SHA-256 of linux64/chrome-linux64.zip and linux-arm64/chrome-linux-arm64.zip
# at CHROMIUM_VERSION (each matched Google's stored MD5 on 2026-10-13).
CHROMIUM_SHA256_AMD64=a24546e0e6c763bf864861ce50498f38783663e24cd2af2a16798c25dc3a9489
CHROMIUM_SHA256_ARM64=bf94336ee2e3edb1279da28a74a744958ba10741e5994351610bc19028482b0b
# Built natively per architecture (PLATFORM=linux/amd64, PLATFORM=linux/arm64)
# and joined into one tag by scripts/build.sh --merge; the browser workflow
# does both, then signs the joined digest. The tag is the build date and the
# workflow's run number, passed as IMAGE_TAG, and the workflow refuses a tag
# that exists, so a rebuild is a new tag and a new digest, never an overwrite.
IMAGE_NAME=agentry-browser
PLATFORMS=linux/amd64,linux/arm64
