# The base-image build-arg of build/ripgrep/Dockerfile, mapped to its upstream
# ref. scripts/build.sh replaces it with our digest-pinned mirror and refuses
# to build if the ref is not in images.tsv. The Rust builder Typst uses
# (Alpine 3.24, the runner image's own runtime base); the binary is static
# (musl), so the base is not linked in.
RUST_IMAGE=rust:1.99.1-alpine3.24
