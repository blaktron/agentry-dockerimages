UPSTREAM_REPO=https://github.com/docker/docker-agent
UPSTREAM_COMMIT=1a0e7ffbcbad4b2cbdd690f48689e87fb0c69599
UPSTREAM_TAG=v1.128.0
UPSTREAM_LICENSE=Apache-2.0
# Published separately from agentry-docker-agent, which holds the vendor's image
# mirrored byte for byte, so the two can be compared under the same tag. This
# build is single-platform (the build host's); the mirror has linux/amd64 and
# linux/arm64.
IMAGE_NAME=agentry-docker-agent-src
IMAGE_TAG=1.128.0
