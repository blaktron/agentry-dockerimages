# Docker Agent, built from pinned upstream source.
#
# The upstream commit is patched: cold-cache-clear.patch adds the
# cold_cache_clear agent setting (README, "agentry-docker-agent-src"). Re-port
# the patch at every commit bump: it must still apply with no fuzz, and its
# tests, which the Dockerfile runs, must still pass.
UPSTREAM_REPO=https://github.com/docker/docker-agent
UPSTREAM_COMMIT=b8fce99da4f6ee28af41a2d1e181296c8f17765e
UPSTREAM_TAG=v1.154.0
UPSTREAM_LICENSE=Apache-2.0
# Published as agentry-docker-agent-src, beside agentry-docker-agent, which holds
# the vendor's image mirrored byte for byte; kept apart, the two can be compared
# at the same version. This build is the runner's default harness.
#
# Built natively per architecture (PLATFORM=linux/amd64, PLATFORM=linux/arm64)
# and joined into one tag by scripts/build.sh --merge; the docker-agent workflow
# does both, then signs the joined digest. The tag is the upstream version, the
# build date and the workflow's run number, passed as IMAGE_TAG
# (1.154.0-2026.10.30.1), and the workflow refuses a tag that exists, so a
# rebuild is a new tag and a new digest, never an overwrite.
IMAGE_NAME=agentry-docker-agent-src
PLATFORMS=linux/amd64,linux/arm64
