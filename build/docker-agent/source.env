UPSTREAM_REPO=https://github.com/docker/docker-agent
UPSTREAM_COMMIT=1a0e7ffbcbad4b2cbdd690f48689e87fb0c69599
UPSTREAM_TAG=v1.128.0
UPSTREAM_LICENSE=Apache-2.0
# A distinct package from agentry-docker-agent on purpose. That one holds the
# digest-verified MIRROR of the vendor's own image; pushing a from-source build
# over the same tag would destroy the one artefact we can prove is byte-identical
# to what upstream published, and would make the tag ambiguous about which of the
# two it named. Keeping both, under the same 1.128.0 tag, lets them be compared
# directly. This build is also single-platform (the host's), where the mirror
# carries linux/amd64 and linux/arm64.
IMAGE_NAME=agentry-docker-agent-src
IMAGE_TAG=1.128.0
