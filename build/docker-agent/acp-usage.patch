diff --git a/pkg/acp/turnusage.go b/pkg/acp/turnusage.go
new file mode 100644
index 000000000..0073e122c
--- /dev/null
+++ b/pkg/acp/turnusage.go
@@ -0,0 +1,31 @@
+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (acp-usage.patch in github.com/blaktron/agentry-dockerimages).
+
+package acp
+
+import (
+	"context"
+
+	acp "github.com/coder/acp-go-sdk"
+
+	"github.com/docker/docker-agent/pkg/runtime"
+)
+
+// emitTurnUsage is the usage_update a prompt's token usage event becomes.
+// Unlike emitUsage, which the /usage command shares and which sends nothing
+// for a model of unknown window, it is sent whatever the window: `used` is
+// the session's tokens either way, and `size` is 0 when the window is not
+// known, so a client counting a session's tokens is not left with none.
+func (a *Agent) emitTurnUsage(ctx context.Context, sid string, usage *runtime.Usage) error {
+	if usage == nil || usage.ContextLimit < 0 {
+		return nil
+	}
+	if usage.ContextLimit > 0 {
+		return a.emitUsage(ctx, sid, usage)
+	}
+	update := acp.SessionUsageUpdate{SessionUpdate: "usage_update", Size: 0, Used: int(usage.ContextLength)}
+	if usage.Cost > 0 {
+		update.Cost = &acp.Cost{Amount: usage.Cost, Currency: "USD"}
+	}
+	return a.sendUpdate(ctx, sid, acp.SessionUpdate{UsageUpdate: &update})
+}
diff --git a/pkg/acp/turnusage_test.go b/pkg/acp/turnusage_test.go
new file mode 100644
index 000000000..38696305d
--- /dev/null
+++ b/pkg/acp/turnusage_test.go
@@ -0,0 +1,51 @@
+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (acp-usage.patch in github.com/blaktron/agentry-dockerimages).
+
+package acp
+
+import (
+	"testing"
+	"testing/synctest"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/docker/docker-agent/pkg/runtime"
+)
+
+func TestTurnUsageWithoutAWindow(t *testing.T) {
+	t.Parallel()
+	synctest.Test(t, func(t *testing.T) {
+		rt := &fakeRuntime{events: []runtime.Event{
+			runtime.NewTokenUsageEvent(testSessionID, "root", &runtime.Usage{ContextLength: 4321, Cost: 0.25}),
+		}}
+		f := newRunAgentFixture(t, rt, &captureWriter{})
+		require.NoError(t, f.runAgent(t.Context(), f.sess))
+
+		updates := f.sessionUpdates(t)
+		require.Len(t, updates, 2)
+		require.NotNil(t, updates[1].UsageUpdate)
+		assert.Equal(t, 0, updates[1].UsageUpdate.Size, "an unknown window is size 0")
+		assert.Equal(t, 4321, updates[1].UsageUpdate.Used)
+		require.NotNil(t, updates[1].UsageUpdate.Cost)
+		assert.InDelta(t, 0.25, updates[1].UsageUpdate.Cost.Amount, 1e-9)
+	})
+}
+
+func TestTurnUsageWithAWindowIsUnchanged(t *testing.T) {
+	t.Parallel()
+	synctest.Test(t, func(t *testing.T) {
+		rt := &fakeRuntime{events: []runtime.Event{
+			runtime.NewTokenUsageEvent(testSessionID, "root", &runtime.Usage{ContextLength: 42, ContextLimit: 1000}),
+		}}
+		f := newRunAgentFixture(t, rt, &captureWriter{})
+		require.NoError(t, f.runAgent(t.Context(), f.sess))
+
+		updates := f.sessionUpdates(t)
+		require.Len(t, updates, 2)
+		require.NotNil(t, updates[1].UsageUpdate)
+		assert.Equal(t, 1000, updates[1].UsageUpdate.Size)
+		assert.Equal(t, 42, updates[1].UsageUpdate.Used)
+		assert.Nil(t, updates[1].UsageUpdate.Cost)
+	})
+}
