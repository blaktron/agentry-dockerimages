# The base-image build-args of build/docker-agent/Dockerfile, each mapped to
# its upstream ref. scripts/build.sh replaces each with our digest-pinned mirror
# and refuses to build if a ref is not in images.tsv.
#
# alpine 3.23 is upstream's choice for the harness (the runner image uses 3.22).
# Keep it: the harness is statically linked against that release's musl.
GO_IMAGE=golang:1.27.0-alpine3.23
ALPINE_IMAGE=alpine:3.23
GATEWAY_IMAGE=docker/mcp-gateway:v2
