# The base-image build-args of build/docker-agent/Dockerfile, each mapped to
# its upstream ref. scripts/build.sh replaces each with our digest-pinned mirror
# and refuses to build if a ref is not in images.tsv.
#
# The Alpine 3.24 bases are the runner image's own. Keep GO_IMAGE on the same
# Alpine as ALPINE_IMAGE: the binary is statically linked against its musl, and
# moving it changes what is linked in.
GO_IMAGE=golang:1.27.3-alpine3.24
ALPINE_IMAGE=alpine:3.24
GATEWAY_IMAGE=docker/mcp-gateway:v2
