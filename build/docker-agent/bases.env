# The build-args of build/docker-agent/Dockerfile, each mapped to the UPSTREAM
# ref it must resolve from. scripts/build.sh rewrites every one of these to our
# own digest-pinned mirror and refuses to build if a ref is not in images.tsv —
# a build that resolves a mutable tag from a public registry is the thing this
# repository exists to stop.
#
# The two alpine 3.23 refs are upstream's own choices (the vendor builds the
# harness on alpine 3.23, while the runner image runs on 3.22). They are NOT
# yet mirrored: resolving their digests hit Docker Hub's anonymous rate limit
# (429) on 2026-09-23. Add them to images.tsv with digests and this build
# unblocks; do not work around it by pointing them at 3.22, which would change
# the musl the harness is statically linked against without a live run to prove
# it still behaves.
GO_IMAGE=golang:1.27.0-alpine3.23
ALPINE_IMAGE=alpine:3.23
GATEWAY_IMAGE=docker/mcp-gateway:v2
