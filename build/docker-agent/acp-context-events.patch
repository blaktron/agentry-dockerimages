@@ -0,0 +1,105 @@
+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (acp-context-events.patch in github.com/blaktron/agentry-dockerimages).
+
+package acp
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+	"testing/synctest"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/docker/docker-agent/pkg/config/types"
+	"github.com/docker/docker-agent/pkg/runtime"
+	"github.com/docker/docker-agent/pkg/session"
+)
+
+type extensionNotification struct {
+	Method string
+	Params map[string]any
+}
+
+// extensionNotifications is every notification in lines whose method is an
+// extension method, in order.
+func extensionNotifications(t *testing.T, lines []string) []extensionNotification {
+	t.Helper()
+	var out []extensionNotification
+	for _, line := range lines {
+		var msg struct {
+			ID     json.RawMessage `json:"id"`
+			Method string          `json:"method"`
+			Params map[string]any  `json:"params"`
+		}
+		require.NoError(t, json.Unmarshal([]byte(line), &msg))
+		if msg.ID == nil && strings.HasPrefix(msg.Method, "_") {
+			out = append(out, extensionNotification{Method: msg.Method, Params: msg.Params})
+		}
+	}
+	return out
+}
+
+func TestPromptReportsAppliedCompactionsAndClears(t *testing.T) {
+	t.Parallel()
+	synctest.Test(t, func(t *testing.T) {
+		applied := runtime.SessionCompactionCompleted(testSessionID, runtime.CompactionOutcomeApplied, "root").(*runtime.SessionCompactionEvent)
+		applied.Reason = "threshold"
+		skipped := runtime.SessionCompactionCompleted(testSessionID, runtime.CompactionOutcomeSkipped, "root").(*runtime.SessionCompactionEvent)
+		skipped.Reason = "threshold"
+		failed := runtime.SessionCompactionCompleted(testSessionID, runtime.CompactionOutcomeFailed, "root").(*runtime.SessionCompactionEvent)
+		failed.Reason = "overflow"
+		overflow := runtime.SessionCompactionCompleted(testSessionID, runtime.CompactionOutcomeApplied, "root").(*runtime.SessionCompactionEvent)
+		overflow.Reason = "overflow"
+		rt := &fakeRuntime{events: []runtime.Event{
+			runtime.ResultsCleared(testSessionID, runtime.ResultsClearedReasonColdCache, "root"),
+			runtime.SessionCompaction(testSessionID, "started", "root"),
+			applied,
+			skipped,
+			failed,
+			overflow,
+		}}
+		f := newRunAgentFixture(t, rt, &captureWriter{})
+		require.NoError(t, f.runAgent(t.Context(), f.sess))
+
+		got := extensionNotifications(t, f.out.lines())
+		assert.Equal(t, []extensionNotification{
+			{Method: ResultsClearedMethod, Params: map[string]any{"sessionId": testSessionID, "reason": "cold_cache"}},
+			{Method: CompactionMethod, Params: map[string]any{"sessionId": testSessionID, "reason": "threshold"}},
+			{Method: CompactionMethod, Params: map[string]any{"sessionId": testSessionID, "reason": "overflow"}},
+		}, got)
+		for _, line := range f.out.lines() {
+			assert.NotContains(t, line, "agent_message_chunk", "a history change is never the agent's words")
+		}
+	})
+}
+
+func TestCompactCommandReportsAnAppliedCompaction(t *testing.T) {
+	t.Parallel()
+	for _, outcome := range []string{runtime.CompactionOutcomeApplied, runtime.CompactionOutcomeSkipped} {
+		t.Run(outcome, func(t *testing.T) {
+			t.Parallel()
+			rt := &commandRuntime{current: "root", commands: map[string]types.Commands{"root": {}}}
+			a, s, peer := newPromptTestAgent(t, rt)
+			s.sess.AddMessage(session.UserMessage("history"))
+			rt.summary = func(_ context.Context, sess *session.Session, _ string, sink runtime.EventSink) {
+				done := runtime.SessionCompactionCompleted(sess.ID, outcome, "root").(*runtime.SessionCompactionEvent)
+				done.Reason = "manual"
+				sink.Emit(done)
+			}
+			_, err := a.Prompt(t.Context(), promptRequest("/compact"))
+			require.NoError(t, err)
+
+			got := extensionNotifications(t, peer.out.(*captureWriter).lines())
+			if outcome == runtime.CompactionOutcomeSkipped {
+				assert.Empty(t, got)
+				return
+			}
+			assert.Equal(t, []extensionNotification{
+				{Method: CompactionMethod, Params: map[string]any{"sessionId": s.id, "reason": "manual"}},
+			}, got)
+		})
+	}
+}
