diff --git a/pkg/acp/contextevents.go b/pkg/acp/contextevents.go
new file mode 100644
index 000000000..8d8e1aed0
--- /dev/null
+++ b/pkg/acp/contextevents.go
@@ -0,0 +1,60 @@
+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (acp-context-events.patch in github.com/blaktron/agentry-dockerimages).
+
+package acp
+
+import (
+	"context"
+
+	"github.com/docker/docker-agent/pkg/runtime"
+)
+
+// The extension notifications that report a change the runtime made to a
+// session's history. They are sent apart from the agent's messages, so a
+// client can count them without reading the agent's words; a client that
+// does not know them ignores them, as ACP asks of any unrecognized
+// extension notification.
+const (
+	// CompactionMethod reports an applied compaction: a summary replaced
+	// part of the history.
+	CompactionMethod = "_agentry/session_compaction"
+	// ResultsClearedMethod reports old tool results replaced with
+	// placeholders.
+	ResultsClearedMethod = "_agentry/results_cleared"
+)
+
+// CompactionNotification is the params of a CompactionMethod notification.
+// Reason is why the compaction ran: "threshold", "overflow" or "manual".
+type CompactionNotification struct {
+	SessionID string `json:"sessionId"`
+	Reason    string `json:"reason,omitempty"`
+}
+
+// ResultsClearedNotification is the params of a ResultsClearedMethod
+// notification. Reason is why the results were cleared ("cold_cache").
+type ResultsClearedNotification struct {
+	SessionID string `json:"sessionId"`
+	Reason    string `json:"reason"`
+}
+
+// compactionApplied reports whether e is the completion of a compaction
+// that changed the history. An empty outcome comes from a runtime that
+// predates outcomes and reads as applied.
+func compactionApplied(e *runtime.SessionCompactionEvent) bool {
+	return e.Status == "completed" && (e.Outcome == runtime.CompactionOutcomeApplied || e.Outcome == "")
+}
+
+// notifyHistoryChange sends the extension notification for event when it
+// is an applied compaction or a results clear, and nothing otherwise.
+func (a *Agent) notifyHistoryChange(ctx context.Context, sessionID string, event runtime.Event) error {
+	switch e := event.(type) {
+	case *runtime.SessionCompactionEvent:
+		if !compactionApplied(e) {
+			return nil
+		}
+		return a.conn.NotifyExtension(ctx, CompactionMethod, CompactionNotification{SessionID: sessionID, Reason: e.Reason})
+	case *runtime.ResultsClearedEvent:
+		return a.conn.NotifyExtension(ctx, ResultsClearedMethod, ResultsClearedNotification{SessionID: sessionID, Reason: e.Reason})
+	}
+	return nil
+}
