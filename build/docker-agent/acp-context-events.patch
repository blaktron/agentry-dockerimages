 	t.Helper()
 	sess.AddMessage(session.UserMessage(text))
+	var events []Event
 	for event := range rt.RunStream(t.Context(), sess) {
 		if failure, ok := event.(*ErrorEvent); ok {
 			t.Fatalf("unexpected runtime error: %s", failure.Error)
 		}
+		events = append(events, event)
 	}
+	return events
+}
+
+// clearsIn is the results_cleared events among events.
+func clearsIn(events []Event) []*ResultsClearedEvent {
+	var out []*ResultsClearedEvent
+	for _, event := range events {
+		if e, ok := event.(*ResultsClearedEvent); ok {
+			out = append(out, e)
+		}
+	}
+	return out
