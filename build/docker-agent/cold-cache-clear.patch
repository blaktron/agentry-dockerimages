+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (cold-cache-clear.patch in github.com/blaktron/agentry-dockerimages).
+
+package runtime
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/docker/docker-agent/pkg/agent"
+	"github.com/docker/docker-agent/pkg/chat"
+	"github.com/docker/docker-agent/pkg/config/latest"
+	"github.com/docker/docker-agent/pkg/session"
+	"github.com/docker/docker-agent/pkg/team"
+	"github.com/docker/docker-agent/pkg/tools"
+)
+
+// coldClock is a clock a tool handler may move while the runtime reads it.
+type coldClock struct {
+	mu sync.Mutex
+	t  time.Time
+}
+
+func (c *coldClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.t
+}
+
+func (c *coldClock) Advance(d time.Duration) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.t = c.t.Add(d)
+}
+
+var coldStart = time.Date(2026, 10, 27, 9, 0, 0, 0, time.UTC)
+
+// coldHistory is three finished turns, each reading a file, the last answer
+// at answeredAt.
+func coldHistory(answeredAt time.Time) *session.Session {
+	sess := session.New(session.WithToolsApproved(true))
+	for i, path := range []string{"a.go", "b.go", "c.go"} {
+		id := "old-" + path
+		sess.AddMessage(session.UserMessage("read " + path))
+		sess.AddMessage(&session.Message{Message: chat.Message{Role: chat.MessageRoleAssistant, CreatedAt: answeredAt.Add(time.Duration(i-2) * time.Minute).Format(time.RFC3339),
+			ToolCalls: []tools.ToolCall{{ID: id, Function: tools.FunctionCall{Name: "read_file", Arguments: `{"path":"` + path + `"}`}}}}})
+		sess.AddMessage(&session.Message{Message: chat.Message{Role: chat.MessageRoleTool, ToolCallID: id, Content: "contents of " + path}})
+		sess.AddMessage(&session.Message{Message: chat.Message{Role: chat.MessageRoleAssistant, CreatedAt: answeredAt.Add(time.Duration(i-2) * time.Minute).Format(time.RFC3339), Content: "read " + path}})
+	}
+	return sess
+}
+
+func coldClearAgent(prov *messageRecordingProvider, extra ...agent.Opt) *agent.Agent {
+	opts := append([]agent.Opt{
+		agent.WithModel(prov),
+		agent.WithColdCacheClear(&latest.ColdCacheClearConfig{After: latest.Duration{Duration: 5 * time.Minute}}),
+	}, extra...)
+	return agent.New("root", "instructions", opts...)
+}
+
+func runColdTurn(t *testing.T, rt *LocalRuntime, sess *session.Session, text string) {
+	t.Helper()
+	sess.AddMessage(session.UserMessage(text))
+	for event := range rt.RunStream(t.Context(), sess) {
+		if failure, ok := event.(*ErrorEvent); ok {
+			t.Fatalf("unexpected runtime error: %s", failure.Error)
+		}
+	}
+}
+
+func resultsOf(messages []chat.Message) map[string]string {
+	out := map[string]string{}
+	for _, m := range messages {
+		if m.Role == chat.MessageRoleTool {
+			out[m.ToolCallID] = m.Content
+		}
+	}
+	return out
+}
+
+func TestColdCacheClearOnTheFirstRequestAfterAPause(t *testing.T) {
+	t.Parallel()
+	clock := &coldClock{t: coldStart}
+	prov := &messageRecordingProvider{id: "test/mock-model", streams: []*mockStream{
+		newStreamBuilder().AddContent("hello again").AddStopWithUsage(1, 1).Build(),
+	}}
+	rt, err := NewLocalRuntime(t.Context(), team.New(team.WithAgents(coldClearAgent(prov))), WithClock(clock.Now), WithSessionCompaction(false), WithModelStore(mockModelStore{}))
+	require.NoError(t, err)
+	sess := coldHistory(coldStart.Add(-2 * time.Hour))
+
+	runColdTurn(t, rt, sess, "back after lunch")
+
+	require.Len(t, prov.recordedMessages, 1)
+	got := resultsOf(prov.recordedMessages[0])
+	assert.Equal(t, `[cleared: read_file({"path":"a.go"}) returned 16 bytes; call it again to read it]`, got["old-a.go"])
+	assert.Equal(t, "contents of b.go", got["old-b.go"])
+	assert.Equal(t, "contents of c.go", got["old-c.go"])
+	// The stored item keeps the original; the session records the clear.
+	assert.Equal(t, "contents of a.go", sess.Messages[2].Message.Message.Content)
+	assert.Equal(t, "old-a.go", sess.AttributesSnapshot()[session.ColdClearedAttribute])
+	stored, err := rt.SessionStore().GetSession(t.Context(), sess.ID)
+	require.NoError(t, err)
+	assert.Equal(t, "old-a.go", stored.AttributesSnapshot()[session.ColdClearedAttribute])
+}
+
+func TestColdCacheClearSkipsASubSession(t *testing.T) {
+	t.Parallel()
+	clock := &coldClock{t: coldStart}
+	prov := &messageRecordingProvider{id: "test/mock-model"}
+	a := coldClearAgent(prov)
+	rt, err := NewLocalRuntime(t.Context(), team.New(team.WithAgents(a)), WithClock(clock.Now), WithSessionCompaction(false), WithModelStore(mockModelStore{}))
+	require.NoError(t, err)
+	sess := coldHistory(coldStart.Add(-2 * time.Hour))
+	sess.ParentID = "parent"
+	sess.AddMessage(session.UserMessage("a delegated task"))
+
+	rt.clearColdToolResults(t.Context(), sess, a)
+	assert.NotContains(t, sess.AttributesSnapshot(), session.ColdClearedAttribute)
+}
+
+func TestColdCacheClearNotWhileTheCacheIsWarm(t *testing.T) {
+	t.Parallel()
+	clock := &coldClock{t: coldStart}
+	prov := &messageRecordingProvider{id: "test/mock-model", streams: []*mockStream{
+		newStreamBuilder().AddContent("still here").AddStopWithUsage(1, 1).Build(),
+	}}
+	rt, err := NewLocalRuntime(t.Context(), team.New(team.WithAgents(coldClearAgent(prov))), WithClock(clock.Now), WithSessionCompaction(false), WithModelStore(mockModelStore{}))
+	require.NoError(t, err)
+	sess := coldHistory(coldStart.Add(-4 * time.Minute))
+
+	runColdTurn(t, rt, sess, "one more thing")
+
+	require.Len(t, prov.recordedMessages, 1)
+	assert.Equal(t, "contents of a.go", resultsOf(prov.recordedMessages[0])["old-a.go"])
+	assert.NotContains(t, sess.AttributesSnapshot(), session.ColdClearedAttribute)
+}
+
+func TestColdCacheClearWithoutTheBlockClearsNothing(t *testing.T) {
+	t.Parallel()
+	clock := &coldClock{t: coldStart}
+	prov := &messageRecordingProvider{id: "test/mock-model", streams: []*mockStream{
+		newStreamBuilder().AddContent("hello").AddStopWithUsage(1, 1).Build(),
+	}}
+	a := agent.New("root", "instructions", agent.WithModel(prov))
+	rt, err := NewLocalRuntime(t.Context(), team.New(team.WithAgents(a)), WithClock(clock.Now), WithSessionCompaction(false), WithModelStore(mockModelStore{}))
+	require.NoError(t, err)
+	sess := coldHistory(coldStart.Add(-2 * time.Hour))
+
+	runColdTurn(t, rt, sess, "back")
+
+	require.Len(t, prov.recordedMessages, 1)
+	assert.Equal(t, "contents of a.go", resultsOf(prov.recordedMessages[0])["old-a.go"])
+}
+
+// TestColdCacheClearNeverInsideATurn: a tool call that outlasts the cache's
+// life clears nothing in its own turn, and the next turn's first request
+// after a pause clears, then sends the same bytes again.
+func TestColdCacheClearNeverInsideATurn(t *testing.T) {
+	t.Parallel()
+	clock := &coldClock{t: coldStart}
+	slow := tools.Tool{Name: "slow_build", Parameters: map[string]any{}, Handler: func(context.Context, tools.ToolCall, tools.Runtime) (*tools.ToolCallResult, error) {
+		clock.Advance(2 * time.Hour)
+		return tools.ResultSuccess("built"), nil
+	}}
+	prov := &messageRecordingProvider{id: "test/mock-model", streams: []*mockStream{
+		newStreamBuilder().AddToolCallName("slow", "slow_build").AddToolCallArguments("slow", "{}").AddToolCallStopWithUsage(1, 1).Build(),
+		newStreamBuilder().AddContent("built it").AddStopWithUsage(1, 1).Build(),
+		newStreamBuilder().AddToolCallName("again", "slow_build").AddToolCallArguments("again", "{}").AddToolCallStopWithUsage(1, 1).Build(),
+		newStreamBuilder().AddContent("built again").AddStopWithUsage(1, 1).Build(),
+	}}
+	rt, err := NewLocalRuntime(t.Context(), team.New(team.WithAgents(coldClearAgent(prov, agent.WithTools(slow)))), WithClock(clock.Now), WithSessionCompaction(false), WithModelStore(mockModelStore{}))
+	require.NoError(t, err)
+	sess := coldHistory(coldStart.Add(-time.Minute))
+
+	runColdTurn(t, rt, sess, "build it")
+	require.Len(t, prov.recordedMessages, 2)
+	for i, request := range prov.recordedMessages {
+		for id, content := range resultsOf(request) {
+			assert.False(t, strings.HasPrefix(content, "[cleared: "), "request %d cleared %s inside the turn", i, id)
+		}
+	}
+
+	clock.Advance(time.Hour)
+	runColdTurn(t, rt, sess, "build it again")
+	require.Len(t, prov.recordedMessages, 4)
+	first, second := resultsOf(prov.recordedMessages[2]), resultsOf(prov.recordedMessages[3])
+	assert.True(t, strings.HasPrefix(first["old-a.go"], "[cleared: read_file"))
+	assert.True(t, strings.HasPrefix(first["old-b.go"], "[cleared: read_file"))
+	assert.Equal(t, "built", first["slow"])
+	// The cleared prefix is byte-stable within the turn.
+	for _, id := range []string{"old-a.go", "old-b.go", "old-c.go", "slow"} {
+		assert.Equal(t, first[id], second[id], id)
+	}
+}
