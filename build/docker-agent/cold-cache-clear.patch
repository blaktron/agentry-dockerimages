@@ -0,0 +1,35 @@
+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (cold-cache-clear.patch in github.com/blaktron/agentry-dockerimages).
+
+package runtime
+
+import (
+	"context"
+	"log/slog"
+
+	"github.com/docker/docker-agent/pkg/agent"
+	"github.com/docker/docker-agent/pkg/session"
+)
+
+// clearColdToolResults runs the agent's cold-cache clear before the first
+// model request of a root session's stream: when the previous model response
+// ended longer ago than the prompt cache lives, the request re-sends the
+// whole history uncached, so old tool results are cleared then and the
+// cleared state is stored for every later request.
+func (r *LocalRuntime) clearColdToolResults(ctx context.Context, sess *session.Session, a *agent.Agent) {
+	c := a.ColdCacheClear()
+	if c == nil || sess.IsSubSession() {
+		return
+	}
+	last, ok := sess.LastResponseAt()
+	if !ok || r.now().Sub(last) <= c.After {
+		return
+	}
+	if !sess.ClearColdToolResults(*c) {
+		return
+	}
+	slog.DebugContext(ctx, "Cleared old tool results after a cold cache", "agent", a.Name(), "session_id", sess.ID, "idle", r.now().Sub(last))
+	if err := r.sessionStore.UpdateSession(ctx, sess); err != nil {
+		slog.WarnContext(ctx, "Failed to persist the cold-cache clear", "session_id", sess.ID, "error", err)
+	}
+}
