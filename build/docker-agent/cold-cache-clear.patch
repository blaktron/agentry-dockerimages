diff --git a/pkg/session/coldclear.go b/pkg/session/coldclear.go
new file mode 100644
index 0000000..c0ef95a
--- /dev/null
+++ b/pkg/session/coldclear.go
@@ -0,0 +1,196 @@
+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (cold-cache-clear.patch in github.com/blaktron/agentry-dockerimages).
+
+package session
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/docker/docker-agent/pkg/agent"
+	"github.com/docker/docker-agent/pkg/chat"
+	"github.com/docker/docker-agent/pkg/tools"
+)
+
+// A cold-cache clear replaces old tool results with a short placeholder at
+// the one moment it costs no prompt cache: the first request of a turn that
+// starts after the cache has expired, when the whole history is re-sent
+// uncached anyway. The stored items keep every original. Which results are
+// cleared is kept as a session attribute, so every later assembly of the
+// history (the next request, a reload, a compaction) sends the same bytes.
+
+// ColdClearedAttribute is the session attribute that lists the tool call IDs
+// whose results are cleared, one per line, sorted.
+const ColdClearedAttribute = "cold_cache_cleared"
+
+// coldClearArgsMax bounds the arguments a placeholder repeats, in bytes.
+const coldClearArgsMax = 200
+
+// LastResponseAt is when the newest assistant message was recorded. It
+// reports false when the session holds none or its time cannot be read.
+func (s *Session) LastResponseAt() (time.Time, bool) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	for i := range slices.Backward(s.Messages) {
+		m := s.Messages[i].Message
+		if m == nil || m.Message.Role != chat.MessageRoleAssistant {
+			continue
+		}
+		t, err := time.Parse(time.RFC3339Nano, m.Message.CreatedAt)
+		return t, err == nil
+	}
+	return time.Time{}, false
+}
+
+// ClearColdToolResults marks for clearing every tool result older than the
+// newest c.KeepTurns turns before the current one, and every result of a tool
+// in c.BrowserTools but the newest c.KeepBrowser of them, wherever they fall.
+// A turn begins at a user message the user sent; the newest such message is
+// the current turn's, which has no results yet. It reports whether a result
+// was newly marked; the caller persists the session.
+func (s *Session) ClearColdToolResults(c agent.ColdCacheClear) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	var turns []int
+	names := map[string]string{}
+	for i, item := range s.Messages {
+		m := item.Message
+		if m == nil {
+			continue
+		}
+		switch m.Message.Role {
+		case chat.MessageRoleUser:
+			if !m.Implicit {
+				turns = append(turns, i)
+			}
+		case chat.MessageRoleAssistant:
+			for _, call := range m.Message.ToolCalls {
+				names[call.ID] = call.Function.Name
+			}
+		}
+	}
+	keepFrom := -1
+	if n := len(turns) - 1 - c.KeepTurns; n >= 0 {
+		keepFrom = turns[n]
+	}
+
+	cleared := s.coldClearedLocked()
+	var browser []string
+	added := false
+	for i := range slices.Backward(s.Messages) {
+		m := s.Messages[i].Message
+		if m == nil || m.Message.Role != chat.MessageRoleTool || m.Message.ToolCallID == "" {
+			continue
+		}
+		id := m.Message.ToolCallID
+		drop := i < keepFrom
+		if slices.Contains(c.BrowserTools, names[id]) {
+			browser = append(browser, id)
+			drop = drop || len(browser) > c.KeepBrowser
+		}
+		if drop && !cleared[id] {
+			cleared[id] = true
+			added = true
+		}
+	}
+	if !added {
+		return false
+	}
+	ids := make([]string, 0, len(cleared))
+	for id := range cleared {
+		ids = append(ids, id)
+	}
+	slices.Sort(ids)
+	if s.Attributes == nil {
+		s.Attributes = map[string]string{}
+	}
+	s.Attributes[ColdClearedAttribute] = strings.Join(ids, "\n")
+	return true
+}
+
+// coldClearedLocked is the set of cleared tool call IDs. The caller holds mu.
+func (s *Session) coldClearedLocked() map[string]bool {
+	set := map[string]bool{}
+	for id := range strings.SplitSeq(s.Attributes[ColdClearedAttribute], "\n") {
+		if id != "" {
+			set[id] = true
+		}
+	}
+	return set
+}
+
+// applyColdClear replaces each cleared tool result in items, a snapshot the
+// caller owns, with its placeholder.
+func (s *Session) applyColdClear(items []Item) {
+	s.mu.RLock()
+	cleared := s.coldClearedLocked()
+	s.mu.RUnlock()
+	if len(cleared) == 0 {
+		return
+	}
+	calls := map[string]tools.ToolCall{}
+	for _, item := range items {
+		if item.Message != nil && item.Message.Message.Role == chat.MessageRoleAssistant {
+			for _, call := range item.Message.Message.ToolCalls {
+				calls[call.ID] = call
+			}
+		}
+	}
+	for _, item := range items {
+		m := item.Message
+		if m == nil || m.Message.Role != chat.MessageRoleTool || !cleared[m.Message.ToolCallID] {
+			continue
+		}
+		m.Message.Content = coldClearPlaceholder(calls[m.Message.ToolCallID], &m.Message)
+		m.Message.MultiContent = nil
+	}
+}
+
+// cutArguments cuts args to at most coldClearArgsMax bytes. A cut never ends
+// inside a word: a token split there (a key, an identifier) is dropped whole,
+// so no prefix of it is sent that a redaction pattern for the whole token
+// would not catch.
+func cutArguments(args string) string {
+	if len(args) <= coldClearArgsMax {
+		return args
+	}
+	cut := coldClearArgsMax
+	for cut > 0 && !utf8.RuneStart(args[cut]) {
+		cut--
+	}
+	for cut > 0 && isTokenByte(args[cut-1]) && isTokenByte(args[cut]) {
+		cut--
+	}
+	return args[:cut] + "…"
+}
+
+// isTokenByte reports whether b can be part of a key or an identifier.
+func isTokenByte(b byte) bool {
+	return b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' || strings.IndexByte("_-+/=.", b) >= 0
+}
+
+// coldClearPlaceholder names the call that produced result and its size,
+// and says how to get it back. It is built from the stored call alone and
+// never quotes the result.
+func coldClearPlaceholder(call tools.ToolCall, result *chat.Message) string {
+	name := call.Function.Name
+	if name == "" {
+		name = "a tool"
+	}
+	args := cutArguments(call.Function.Arguments)
+	size := fmt.Sprintf("%d bytes", toolResultTextualBytes(result))
+	attachments := 0
+	for _, part := range result.MultiContent {
+		if part.Type != chat.MessagePartTypeText && part.Type != chat.MessagePartTypeDocument {
+			attachments++
+		}
+	}
+	if attachments > 0 {
+		size += fmt.Sprintf(" and %d attachments", attachments)
+	}
+	return fmt.Sprintf("[cleared: %s(%s) returned %s; call it again to read it]", name, args, size)
+}
