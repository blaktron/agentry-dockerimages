+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (cold-cache-clear.patch in github.com/blaktron/agentry-dockerimages).
+
+package latest
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestColdCacheClearParses(t *testing.T) {
+	t.Parallel()
+	cfg, err := parse([]byte(`version: "16"
+agents:
+  root:
+    model: anthropic/claude-sonnet-4-5
+    cold_cache_clear:
+      after: 5m
+      keep_turns: 3
+      keep_browser: 1
+      browser_tools: [browser_snapshot, browser_navigate]
+`))
+	require.NoError(t, err)
+	require.Len(t, cfg.Agents, 1)
+	c := cfg.Agents[0].ColdCacheClear
+	require.NotNil(t, c)
+	assert.Equal(t, 5*time.Minute, c.After.Duration)
+	require.NotNil(t, c.KeepTurns)
+	assert.Equal(t, 3, *c.KeepTurns)
+	require.NotNil(t, c.KeepBrowser)
+	assert.Equal(t, 1, *c.KeepBrowser)
+	assert.Equal(t, []string{"browser_snapshot", "browser_navigate"}, c.BrowserTools)
+}
+
+func TestColdCacheClearIsValidated(t *testing.T) {
+	t.Parallel()
+	for name, block := range map[string]string{
+		"no after":         "      keep_turns: 2\n",
+		"negative keep":    "      after: 5m\n      keep_turns: -1\n",
+		"negative browser": "      after: 5m\n      keep_browser: -1\n",
+		"unknown key":      "      after: 5m\n      keep_everything: true\n",
+		"unparsable after": "      after: soon\n",
+	} {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			_, err := parse([]byte("version: \"16\"\nagents:\n  root:\n    model: anthropic/claude-sonnet-4-5\n    cold_cache_clear:\n" + block))
+			assert.Error(t, err)
+		})
+	}
+}
