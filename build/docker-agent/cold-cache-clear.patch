+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (cold-cache-clear.patch in github.com/blaktron/agentry-dockerimages).
+
+package session
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+	"unicode/utf8"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/docker/docker-agent/pkg/agent"
+	"github.com/docker/docker-agent/pkg/chat"
+	"github.com/docker/docker-agent/pkg/tools"
+)
+
+var coldBase = time.Date(2026, 10, 27, 9, 0, 0, 0, time.UTC)
+
+// coldTurn appends a turn to sess: the user's message, one call of each of
+// calls with its result, and the closing answer, the turn's minute apart from
+// the others.
+func coldTurn(sess *Session, n int, calls ...[2]string) {
+	at := coldBase.Add(time.Duration(n) * time.Minute).Format(time.RFC3339)
+	sess.AddMessage(UserMessage(fmt.Sprintf("question %d", n)))
+	for i, c := range calls {
+		id := fmt.Sprintf("t%d-%d", n, i)
+		sess.AddMessage(&Message{Message: chat.Message{Role: chat.MessageRoleAssistant, CreatedAt: at,
+			ToolCalls: []tools.ToolCall{{ID: id, Function: tools.FunctionCall{Name: c[0], Arguments: c[1]}}}}})
+		sess.AddMessage(&Message{Message: chat.Message{Role: chat.MessageRoleTool, ToolCallID: id,
+			Content: fmt.Sprintf("result of %s in turn %d", c[0], n)}})
+	}
+	sess.AddMessage(&Message{Message: chat.Message{Role: chat.MessageRoleAssistant, CreatedAt: at, Content: fmt.Sprintf("answer %d", n)}})
+}
+
+// toolResults maps each tool result the model would receive by its call ID.
+func toolResults(messages []chat.Message) map[string]string {
+	out := map[string]string{}
+	for _, m := range messages {
+		if m.Role == chat.MessageRoleTool {
+			out[m.ToolCallID] = m.Content
+		}
+	}
+	return out
+}
+
+func coldAgent() *agent.Agent { return agent.New("root", "instructions") }
+
+var coldConfig = agent.ColdCacheClear{KeepTurns: 2, KeepBrowser: 2, BrowserTools: []string{"browser_snapshot", "browser_navigate"}}
+
+func TestColdClearKeepsTheNewestTurnsAndBrowserResults(t *testing.T) {
+	t.Parallel()
+	sess := New()
+	coldTurn(sess, 1, [2]string{"fs_read", `{"path":"a.go"}`}, [2]string{"browser_snapshot", `{}`})
+	coldTurn(sess, 2, [2]string{"fs_read", `{"path":"b.go"}`})
+	coldTurn(sess, 3, [2]string{"browser_navigate", `{"url":"https://example.com"}`}, [2]string{"browser_snapshot", `{}`}, [2]string{"browser_snapshot", `{}`})
+	coldTurn(sess, 4, [2]string{"fs_read", `{"path":"c.go"}`})
+	sess.AddMessage(UserMessage("the question after the pause"))
+
+	require.True(t, sess.ClearColdToolResults(coldConfig))
+	got := toolResults(sess.GetMessages(coldAgent()))
+
+	cleared := []string{"t1-0", "t1-1", "t2-0", "t3-0"}
+	kept := []string{"t3-1", "t3-2", "t4-0"}
+	for _, id := range cleared {
+		assert.True(t, strings.HasPrefix(got[id], "[cleared: "), "%s should be cleared: %q", id, got[id])
+	}
+	for _, id := range kept {
+		assert.True(t, strings.HasPrefix(got[id], "result of "), "%s should be whole: %q", id, got[id])
+	}
+	assert.Equal(t, `[cleared: fs_read({"path":"a.go"}) returned 27 bytes; call it again to read it]`, got["t1-0"])
+}
+
+func TestColdClearKeepsOnlyTheNewestBrowserResultsInsideKeptTurns(t *testing.T) {
+	t.Parallel()
+	sess := New()
+	coldTurn(sess, 1, [2]string{"browser_snapshot", `{}`}, [2]string{"browser_snapshot", `{}`}, [2]string{"browser_snapshot", `{}`})
+	sess.AddMessage(UserMessage("again"))
+
+	require.True(t, sess.ClearColdToolResults(coldConfig))
+	got := toolResults(sess.GetMessages(coldAgent()))
+	assert.True(t, strings.HasPrefix(got["t1-0"], "[cleared: browser_snapshot({})"))
+	assert.Equal(t, "result of browser_snapshot in turn 1", got["t1-1"])
+	assert.Equal(t, "result of browser_snapshot in turn 1", got["t1-2"])
+}
+
+func TestColdClearWithNothingOldEnoughChangesNothing(t *testing.T) {
+	t.Parallel()
+	sess := New()
+	coldTurn(sess, 1, [2]string{"fs_read", `{"path":"a.go"}`})
+	sess.AddMessage(UserMessage("again"))
+	before := sess.GetMessages(coldAgent())
+
+	assert.False(t, sess.ClearColdToolResults(coldConfig))
+	assert.Equal(t, before, sess.GetMessages(coldAgent()))
+	assert.NotContains(t, sess.AttributesSnapshot(), ColdClearedAttribute)
+}
+
+func TestColdClearPlaceholderNeverQuotesTheResult(t *testing.T) {
+	t.Parallel()
+	const resultSecret = "sk-result-0123456789abcdef"
+	sess := New()
+	sess.AddMessage(UserMessage("read the env"))
+	sess.AddMessage(&Message{Message: chat.Message{Role: chat.MessageRoleAssistant, CreatedAt: coldBase.Format(time.RFC3339),
+		ToolCalls: []tools.ToolCall{{ID: "c1", Function: tools.FunctionCall{Name: "fs_read", Arguments: `{"path":".env","token":"[REDACTED]"}`}}}}})
+	sess.AddMessage(&Message{Message: chat.Message{Role: chat.MessageRoleTool, ToolCallID: "c1", Content: "API_KEY=" + resultSecret,
+		MultiContent: []chat.MessagePart{{Type: chat.MessagePartTypeText, Text: "API_KEY=" + resultSecret}, {Type: chat.MessagePartTypeImageURL, ImageURL: &chat.MessageImageURL{URL: "data:image/png;base64,AAAA"}}}}})
+	sess.AddMessage(UserMessage("one"))
+	sess.AddMessage(UserMessage("two"))
+	sess.AddMessage(UserMessage("three"))
+
+	require.True(t, sess.ClearColdToolResults(agent.ColdCacheClear{KeepTurns: 2, KeepBrowser: 2}))
+	for _, m := range sess.GetMessages(coldAgent()) {
+		if m.Role != chat.MessageRoleTool {
+			continue
+		}
+		assert.NotContains(t, m.Content, resultSecret)
+		assert.Nil(t, m.MultiContent)
+		assert.Equal(t, `[cleared: fs_read({"path":".env","token":"[REDACTED]"}) returned 34 bytes and 1 attachments; call it again to read it]`, m.Content)
+	}
+	// The stored result is the original.
+	assert.Contains(t, sess.Messages[2].Message.Message.Content, resultSecret)
+}
+
+func TestColdClearCutsLongArguments(t *testing.T) {
+	t.Parallel()
+	args := `{"query":"` + strings.Repeat("é", 150) + `"}`
+	p := coldClearPlaceholder(tools.ToolCall{Function: tools.FunctionCall{Name: "search", Arguments: args}}, &chat.Message{Content: "x"})
+	inner := strings.TrimSuffix(strings.TrimPrefix(p, "[cleared: search("), ") returned 1 bytes; call it again to read it]")
+	assert.True(t, utf8.ValidString(inner))
+	assert.True(t, strings.HasSuffix(inner, "…"))
+	assert.LessOrEqual(t, len(strings.TrimSuffix(inner, "…")), coldClearArgsMax)
+}
+
+func TestColdClearNeverCutsInsideAToken(t *testing.T) {
+	t.Parallel()
+	const secret = "ghp_0123456789abcdefghijklmnopqrstuvwxyz"
+	prefix := `{"note":"` + strings.Repeat("a b ", 44) + `","token":"`
+	require.Less(t, len(prefix), coldClearArgsMax)
+	require.Greater(t, len(prefix)+len(secret), coldClearArgsMax)
+	got := cutArguments(prefix + secret + `"}`)
+	assert.NotContains(t, got, "ghp_")
+	assert.Equal(t, prefix+"…", got)
+
+	// A cut between two words keeps the word before it whole.
+	words := strings.Repeat("word ", 60)
+	got = cutArguments(words)
+	assert.True(t, strings.HasSuffix(got, "word …"), got)
+}
+
+func TestColdClearIsStableAcrossRequestsReloadsAndCompaction(t *testing.T) {
+	t.Parallel()
+	sess := New()
+	coldTurn(sess, 1, [2]string{"fs_read", `{"path":"a.go"}`})
+	coldTurn(sess, 2, [2]string{"fs_read", `{"path":"b.go"}`})
+	coldTurn(sess, 3, [2]string{"fs_read", `{"path":"c.go"}`})
+	sess.AddMessage(UserMessage("after the pause"))
+	require.True(t, sess.ClearColdToolResults(agent.ColdCacheClear{KeepTurns: 2, KeepBrowser: 2}))
+	first := sess.GetMessages(coldAgent())
+
+	// A second clear with the same history marks nothing new.
+	assert.False(t, sess.ClearColdToolResults(agent.ColdCacheClear{KeepTurns: 2, KeepBrowser: 2}))
+	assert.Equal(t, first, sess.GetMessages(coldAgent()))
+
+	// A reload of the stored session assembles the same history.
+	data, err := json.Marshal(sess)
+	require.NoError(t, err)
+	loaded := New()
+	require.NoError(t, json.Unmarshal(data, loaded))
+	assert.Equal(t, first, loaded.GetMessages(coldAgent()))
+
+	// The compaction's input carries the placeholder, not the original.
+	compaction, _, _ := sess.CompactionInput()
+	assert.True(t, strings.HasPrefix(toolResults(compaction)["t1-0"], "[cleared: fs_read"))
+	assert.Equal(t, "result of fs_read in turn 1", sess.Messages[2].Message.Message.Content)
+}
+
+func TestColdClearAddsToAnEarlierClear(t *testing.T) {
+	t.Parallel()
+	sess := New()
+	coldTurn(sess, 1, [2]string{"fs_read", `{"path":"a.go"}`})
+	coldTurn(sess, 2, [2]string{"fs_read", `{"path":"b.go"}`})
+	coldTurn(sess, 3, [2]string{"fs_read", `{"path":"c.go"}`})
+	sess.AddMessage(UserMessage("after the first pause"))
+	require.True(t, sess.ClearColdToolResults(agent.ColdCacheClear{KeepTurns: 2, KeepBrowser: 2}))
+	coldTurn(sess, 5, [2]string{"fs_read", `{"path":"d.go"}`})
+	sess.AddMessage(UserMessage("after the second pause"))
+	require.True(t, sess.ClearColdToolResults(agent.ColdCacheClear{KeepTurns: 2, KeepBrowser: 2}))
+	got := toolResults(sess.GetMessages(coldAgent()))
+	// The first pause's message began a turn of its own, so turn 3 is
+	// now older than the two kept.
+	for _, id := range []string{"t1-0", "t2-0", "t3-0"} {
+		assert.True(t, strings.HasPrefix(got[id], "[cleared: "), id)
+	}
+	assert.Equal(t, "result of fs_read in turn 5", got["t5-0"])
+	assert.Equal(t, "t1-0\nt2-0\nt3-0", sess.AttributesSnapshot()[ColdClearedAttribute])
+}
+
+func TestLastResponseAt(t *testing.T) {
+	t.Parallel()
+	sess := New()
+	_, ok := sess.LastResponseAt()
+	assert.False(t, ok)
+	coldTurn(sess, 3)
+	sess.AddMessage(UserMessage("next"))
+	at, ok := sess.LastResponseAt()
+	require.True(t, ok)
+	assert.Equal(t, coldBase.Add(3*time.Minute), at)
+}
