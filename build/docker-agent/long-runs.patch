new file mode 100644
index 000000000..5532ce2e7
--- /dev/null
+++ b/pkg/modelerrors/overflow_window.go
@@ -0,0 +1,46 @@
+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (long-runs.patch in github.com/blaktron/agentry-dockerimages).
+
+package modelerrors
+
+import (
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// overflowWindowPatterns find the context window a server states when it
+// refuses a request as too long. Each has one group, the window in tokens.
+var overflowWindowPatterns = []*regexp.Regexp{
+	// OpenAI, vLLM: "This model's maximum context length is 32768 tokens."
+	regexp.MustCompile(`(?i)maximum context length is ([0-9][0-9,]*) tokens`),
+	// llama.cpp server: "... exceeds the available context size (2048 tokens)"
+	regexp.MustCompile(`(?i)available context size \(([0-9][0-9,]*) tokens\)`),
+	// llama.cpp's error body ("n_ctx":2048) and its log wording, which LM
+	// Studio passes on ("n_keep: 5746 >= n_ctx: 4096").
+	regexp.MustCompile(`"?n_ctx"?\s*[:=]\s*([0-9]+)`),
+}
+
+// maxStatedWindow bounds what OverflowWindow accepts, so a stray number in
+// an error message cannot pose as a window.
+const maxStatedWindow = 100_000_000
+
+// OverflowWindow returns the context window, in tokens, that a
+// context-overflow error states, or 0 when it states none.
+func OverflowWindow(err error) int64 {
+	if err == nil {
+		return 0
+	}
+	msg := err.Error()
+	for _, re := range overflowWindowPatterns {
+		m := re.FindStringSubmatch(msg)
+		if m == nil {
+			continue
+		}
+		n, perr := strconv.ParseInt(strings.ReplaceAll(m[1], ",", ""), 10, 64)
+		if perr == nil && n > 0 && n <= maxStatedWindow {
+			return n
+		}
+	}
+	return 0
+}
