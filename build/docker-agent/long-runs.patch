--- /dev/null
+++ b/pkg/runtime/notes_reminder.go
@@ -0,0 +1,26 @@
+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (long-runs.patch in github.com/blaktron/agentry-dockerimages).
+
+package runtime
+
+import "strings"
+
+// withNotesReminder ends a compaction summary with one sentence pointing the
+// agent at the notes file it keeps, so that after the summary replaces the
+// conversation it reads where it had got to before going on. The sentence is
+// part of the stored summary, so a reload and later requests send the same
+// bytes. A copy the summariser carried over from an earlier summary is
+// removed first, so the sentence appears once. A summary is returned
+// unchanged when there is no notes file or the path is not a single line.
+func withNotesReminder(summary, notes string) string {
+	notes = strings.TrimSpace(notes)
+	if notes == "" || strings.ContainsAny(notes, "\r\n") || strings.TrimSpace(summary) == "" {
+		return summary
+	}
+	reminder := "Your notes are in " + notes + ": read that file before anything else, then go on from where it says you are, and keep it up to date."
+	body := strings.TrimRight(strings.ReplaceAll(summary, reminder, ""), " \n")
+	if body == "" {
+		return summary
+	}
+	return body + "\n\n" + reminder
+}
