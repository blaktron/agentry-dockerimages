-// Flex gets the longer window; every other provider and tier keeps the default.
+// streamIdleTimeoutFor returns the idle timeout for p's streams. A positive
+// provider_opts.stream_idle_timeout sets it (added by Agentry's build); else
+// only Gemini Flex gets the longer window, and every other provider and tier
+// keeps the default.
 func streamIdleTimeoutFor(p provider.Provider) time.Duration {
 	cfg := p.BaseConfig().ModelConfig
+	if d := configuredStreamIdleTimeout(cfg.ProviderOpts); d > 0 {
+		return d
+	}
 	if cfg.Provider == "google" && cfg.ProviderOpts["service_tier"] == "flex" {
 		return flexStreamIdleTimeout
 	}
