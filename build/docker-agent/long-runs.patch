+
+func TestLongRunLMStudioRefusalIsAnOverflow(t *testing.T) {
+	t.Parallel()
+
+	// LM Studio sends this as an SSE error event on a 200 response.
+	for _, msg := range []string{
+		`received error while streaming: {"message":"The number of tokens to keep from the initial prompt is greater than the context length."}`,
+		"The number of tokens to keep from the initial prompt is greater than the context length (n_keep: 5746 >= n_ctx: 4096). Try to load the model with a larger context length, or provide a shorter input",
+	} {
+		err := errors.New(msg)
+		assert.True(t, IsContextOverflowError(err), msg)
+		assert.Equal(t, OverflowKindTokens, classifyOverflow(err), msg)
+	}
+}
+
+func TestLongRunOverflowStatesTheWindow(t *testing.T) {
+	t.Parallel()
+
+	cases := []struct {
+		name string
+		msg  string
+		want int64
+	}{
+		{"vLLM", "This model's maximum context length is 32768 tokens. However, you requested 40961 tokens (36865 in the messages, 4096 in the completion).", 32768},
+		{"OpenAI with separators", "This model's maximum context length is 128,000 tokens. However, your messages resulted in 130,512 tokens.", 128000},
+		{"llama.cpp message", "request (12009 tokens) exceeds the available context size (2048 tokens), try increasing it", 2048},
+		{"llama.cpp body", `400 Bad Request {"error":{"code":400,"message":"the request exceeds the available context size, try increasing it","type":"exceed_context_size_error","n_prompt_tokens":12009,"n_ctx":4096}}`, 4096},
+		{"LM Studio", "The number of tokens to keep from the initial prompt is greater than the context length (n_keep: 5746 >= n_ctx: 4096).", 4096},
+		{"no window stated", "the request exceeds the available context size, try increasing it", 0},
+		{"implausible number", "maximum context length is 999999999999 tokens", 0},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			assert.Equal(t, tc.want, OverflowWindow(NewContextOverflowError(errors.New(tc.msg))))
+		})
+	}
+	assert.Zero(t, OverflowWindow(nil))
+}
