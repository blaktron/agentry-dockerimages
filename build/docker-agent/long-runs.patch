+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (long-runs.patch in github.com/blaktron/agentry-dockerimages).
+
+package runtime
+
+import (
+	"testing"
+	"time"
+
+	"github.com/goccy/go-yaml"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/docker/docker-agent/pkg/config/latest"
+)
+
+func TestLongRunStreamIdleTimeoutFromProviderOpts(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name string
+		opts map[string]any
+		want time.Duration
+	}{
+		{name: "duration string", opts: map[string]any{"stream_idle_timeout": "30m"}, want: 30 * time.Minute},
+		{name: "seconds as YAML integer", opts: map[string]any{"stream_idle_timeout": uint64(1800)}, want: 30 * time.Minute},
+		{name: "seconds as int", opts: map[string]any{"stream_idle_timeout": 90}, want: 90 * time.Second},
+		{name: "seconds as float", opts: map[string]any{"stream_idle_timeout": 1.5}, want: 1500 * time.Millisecond},
+		{name: "overrides flex", opts: map[string]any{"stream_idle_timeout": "20m", "service_tier": "flex"}, want: 20 * time.Minute},
+		{name: "unparsable keeps the default", opts: map[string]any{"stream_idle_timeout": "soon"}, want: defaultStreamIdleTimeout},
+		{name: "zero keeps the default", opts: map[string]any{"stream_idle_timeout": "0s"}, want: defaultStreamIdleTimeout},
+		{name: "negative keeps the default", opts: map[string]any{"stream_idle_timeout": -5}, want: defaultStreamIdleTimeout},
+		{name: "wrong type keeps the default", opts: map[string]any{"stream_idle_timeout": true}, want: defaultStreamIdleTimeout},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			p := &configuredProvider{cfg: latest.ModelConfig{Provider: "openai", Model: "m", ProviderOpts: tt.opts}}
+			assert.Equal(t, tt.want, streamIdleTimeoutFor(p))
+		})
+	}
+}
+
+func TestLongRunStreamIdleTimeoutParsesFromYAML(t *testing.T) {
+	t.Parallel()
+
+	for _, value := range []string{"30m", "1800"} {
+		var cfg latest.ModelConfig
+		require.NoError(t, yaml.UnmarshalWithOptions([]byte("provider: openai\nmodel: m\nbase_url: http://127.0.0.1:8000/v1\nprovider_opts:\n  stream_idle_timeout: "+value+"\n"), &cfg, yaml.Strict()))
+		assert.Equal(t, 30*time.Minute, streamIdleTimeoutFor(&configuredProvider{cfg: cfg}), value)
+	}
+}
