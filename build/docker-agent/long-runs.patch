+	"github.com/docker/docker-agent/pkg/tools"
+)
+
+func longSession() *session.Session {
+	page := strings.Repeat("a page of the input file. ", 400) // about 10k characters
+	var items []session.Item
+	for range 4 {
+		items = append(items,
+			session.NewMessageItem(&session.Message{Message: chat.Message{Role: chat.MessageRoleUser, Content: page}}),
+			session.NewMessageItem(&session.Message{Message: chat.Message{Role: chat.MessageRoleAssistant, Content: page}}),
+		)
+	}
+	return session.New(session.WithMessages(items))
+}
+
+// An overflow on a model whose window is unknown compacts against an
+// estimated window and retries; it emits no error event, which would end
+// an --exec run.
+func TestLongRunOverflowWithAnUnknownWindowCompacts(t *testing.T) {
+	t.Parallel()
+
+	for _, refusal := range []string{
+		"This model's maximum context length is 8192 tokens. However, you requested 21000 tokens.",
+		"the request exceeds the available context size, try increasing it",
+	} {
+		t.Run(refusal, func(t *testing.T) {
+			t.Parallel()
+
+			summary := newStreamBuilder().AddContent("the summary").AddStopWithUsage(50, 7).Build()
+			prov := &queueProvider{id: "test/local-model", streams: []chat.MessageStream{summary}}
+			root := agent.New("root", "test", agent.WithModel(prov))
+			rt, err := NewLocalRuntime(t.Context(), team.New(team.WithAgents(root)), WithModelStore(mockModelStore{}))
+			require.NoError(t, err)
+
+			sess := longSession()
+			events := make(chan Event, 64)
+			_, sp := noop.NewTracerProvider().Tracer("t").Start(t.Context(), "x")
+			count := 0
+
+			outcome := rt.handleStreamError(t.Context(), sess, root, modelerrors.NewContextOverflowError(errors.New(refusal)), 0, &count, sp, NewChannelSink(events))
+
+			assert.Equal(t, streamErrorRetry, outcome)
+			var sawSummary bool
+			for _, ev := range drainEvents(events) {
+				switch e := ev.(type) {
+				case *ErrorEvent:
+					t.Errorf("unexpected error event: %s", e.Error)
+				case *SessionSummaryEvent:
+					sawSummary = true
+				}
+			}
+			assert.True(t, sawSummary, "the session should be compacted")
+			assert.Equal(t, "the summary", sess.LastSummary())
+		})
+	}
+}
+
+// A manual compaction carries no estimate, so an unknown window still
+// fails it as before.
+func TestLongRunManualCompactionStillNeedsAWindow(t *testing.T) {
+	t.Parallel()
+
+	prov := &queueProvider{id: "test/local-model"}
+	root := agent.New("root", "test", agent.WithModel(prov))
+	rt, err := NewLocalRuntime(t.Context(), team.New(team.WithAgents(root)), WithSessionCompaction(false), WithModelStore(mockModelStore{}))
+	require.NoError(t, err)
+
+	kinds := collectCompactionEvents(t, rt, longSession())
+	assert.Equal(t, []string{"compaction:started", "error", "compaction:completed:failed"}, kinds)
+}
+
+func TestLongRunEstimateOverflowWindow(t *testing.T) {
+	t.Parallel()
+
+	root := agent.New("root", "test")
+	sess := longSession()
+
+	stated := modelerrors.NewContextOverflowError(errors.New("This model's maximum context length is 8192 tokens."))
+	assert.Equal(t, int64(8192), estimateOverflowWindow(stated, sess, root))
+
+	unstated := modelerrors.NewContextOverflowError(errors.New("the request exceeds the available context size, try increasing it"))
+	got := estimateOverflowWindow(unstated, sess, root)
+	// Eight messages of about 10k characters: about 20k tokens, halved.
+	assert.Greater(t, got, int64(5_000))
+	assert.Less(t, got, int64(20_000))
+
+	assert.Zero(t, estimateOverflowWindow(unstated, session.New(), agent.New("root", "")))
+}
+
+// refusingProvider refuses its first refuse calls as too long, then serves
+// streams in order.
+type refusingProvider struct {
+	queueProvider
+	refuse int
+	calls  int
+}
+
+func (p *refusingProvider) CreateChatCompletionStream(ctx context.Context, msgs []chat.Message, ts []tools.Tool) (chat.MessageStream, error) {
+	p.mu.Lock()
+	p.calls++
+	refused := p.calls <= p.refuse
+	p.mu.Unlock()
+	if refused {
+		return nil, errors.New("error, status code: 400, message: the request exceeds the available context size, try increasing it")
+	}
+	return p.queueProvider.CreateChatCompletionStream(ctx, msgs, ts)
+}
+
+func (p *refusingProvider) BaseConfig() base.Config {
+	cfg := base.Config{}
+	cfg.RebuildProvider = func(context.Context, *latest.ModelConfig, ...options.Opt) (provider.Provider, error) { return p, nil }
+	return cfg
+}
+
+// When the summary call overflows the estimated window too, the window is
+// halved and the summary tried again.
+func TestLongRunSummaryOverflowHalvesTheEstimate(t *testing.T) {
+	t.Parallel()
+
+	summary := newStreamBuilder().AddContent("the summary").AddStopWithUsage(50, 7).Build()
+	prov := &refusingProvider{queueProvider: queueProvider{id: "test/local-model", streams: []chat.MessageStream{summary}}, refuse: 1}
+	root := agent.New("root", "test", agent.WithModel(prov))
+	rt, err := NewLocalRuntime(t.Context(), team.New(team.WithAgents(root)), WithModelStore(mockModelStore{}))
+	require.NoError(t, err)
+
+	sess := longSession()
+	events := make(chan Event, 64)
+	_, sp := noop.NewTracerProvider().Tracer("t").Start(t.Context(), "x")
+	count := 0
+	refusal := modelerrors.NewContextOverflowError(errors.New("the request exceeds the available context size, try increasing it"))
+
+	outcome := rt.handleStreamError(t.Context(), sess, root, refusal, 0, &count, sp, NewChannelSink(events))
+
+	assert.Equal(t, streamErrorRetry, outcome)
+	for _, ev := range drainEvents(events) {
+		if e, ok := ev.(*ErrorEvent); ok {
+			t.Errorf("unexpected error event: %s", e.Error)
+		}
+	}
+	assert.Equal(t, "the summary", sess.LastSummary())
+	assert.GreaterOrEqual(t, prov.calls, 2, "the summary is tried again after its own overflow")
+}
+
+func TestLongRunRetryWithSmallerEstimate(t *testing.T) {
+	t.Parallel()
+
+	overflow := errors.New("The conversation has exceeded the model's context window. Compact the conversation to reduce its size, or start a new session.")
+	ctx := t.Context()
+	assert.True(t, retryWithSmallerEstimate(ctx, true, 0, 16_000, overflow))
+	assert.False(t, retryWithSmallerEstimate(ctx, false, 0, 16_000, overflow), "a known window is not halved")
+	assert.False(t, retryWithSmallerEstimate(ctx, true, maxEstimateHalvings, 16_000, overflow), "halvings are bounded")
+	assert.False(t, retryWithSmallerEstimate(ctx, true, 0, minEstimatedWindow, overflow), "the window has a floor")
+	assert.False(t, retryWithSmallerEstimate(ctx, true, 0, 16_000, errors.New("boom")), "only an overflow is retried")
+	assert.False(t, retryWithSmallerEstimate(ctx, true, 0, 16_000, nil))
+}
