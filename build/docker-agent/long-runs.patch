new file mode 100644
index 000000000..02839e3ad
--- /dev/null
+++ b/pkg/runtime/stream_idle_option.go
@@ -0,0 +1,39 @@
+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (long-runs.patch in github.com/blaktron/agentry-dockerimages).
+
+package runtime
+
+import (
+	"math"
+	"time"
+)
+
+// configuredStreamIdleTimeout reads provider_opts.stream_idle_timeout: a
+// duration string ("30m") or a number of seconds. A model server of the
+// person's own can take longer than the default to send its first byte, while
+// it reads a long prompt it has not cached. It returns 0 when the option is
+// absent or not a positive duration, so the default applies.
+func configuredStreamIdleTimeout(opts map[string]any) time.Duration {
+	switch v := opts["stream_idle_timeout"].(type) {
+	case string:
+		if d, err := time.ParseDuration(v); err == nil && d > 0 {
+			return d
+		}
+	case int:
+		return secondsDuration(float64(v))
+	case int64:
+		return secondsDuration(float64(v))
+	case uint64:
+		return secondsDuration(float64(v))
+	case float64:
+		return secondsDuration(v)
+	}
+	return 0
+}
+
+func secondsDuration(s float64) time.Duration {
+	if s <= 0 || s > math.MaxInt64/float64(time.Second) {
+		return 0
+	}
+	return time.Duration(s * float64(time.Second))
+}
