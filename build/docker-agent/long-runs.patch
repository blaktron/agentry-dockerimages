diff --git a/pkg/runtime/overflow_window.go b/pkg/runtime/overflow_window.go
new file mode 100644
index 000000000..69016e275
--- /dev/null
+++ b/pkg/runtime/overflow_window.go
@@ -0,0 +1,74 @@
+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (long-runs.patch in github.com/blaktron/agentry-dockerimages).
+
+package runtime
+
+import (
+	"context"
+	"log/slog"
+	"strings"
+
+	"github.com/docker/docker-agent/pkg/agent"
+	"github.com/docker/docker-agent/pkg/compaction"
+	"github.com/docker/docker-agent/pkg/modelerrors"
+	"github.com/docker/docker-agent/pkg/session"
+)
+
+// overflowWindowKey carries, through an overflow compaction, the window
+// estimated from the refused request when the model's own window is unknown.
+type overflowWindowKey struct{}
+
+func withOverflowWindow(ctx context.Context, tokens int64) context.Context {
+	if tokens <= 0 {
+		return ctx
+	}
+	return context.WithValue(ctx, overflowWindowKey{}, tokens)
+}
+
+func overflowWindowFrom(ctx context.Context) int64 {
+	n, _ := ctx.Value(overflowWindowKey{}).(int64)
+	return n
+}
+
+// estimateOverflowWindow returns a window to compact against after the
+// model refused a request as too long and no window is known: the window
+// the refusal states, or else half the refused request's estimated size.
+// The real window is smaller than the refused request, so half of it errs
+// towards a summary call that fits; compacting more than needed is the cost.
+// It returns 0 when the conversation is empty.
+func estimateOverflowWindow(err error, sess *session.Session, a *agent.Agent) int64 {
+	if n := modelerrors.OverflowWindow(err); n > 0 {
+		return n
+	}
+	messages := sess.GetMessages(a)
+	estimator := compaction.NewSliceEstimator(messages)
+	var total int64
+	for i := range messages {
+		total += estimator.EstimateMessageTokens(&messages[i])
+	}
+	return total / 2
+}
+
+// maxEstimateHalvings bounds how often a summary call that overflows an
+// estimated window is tried again with half of it.
+const maxEstimateHalvings = 3
+
+// minEstimatedWindow is the smallest window a halving goes down to.
+const minEstimatedWindow = 1024
+
+// retryWithSmallerEstimate reports whether a summary call that failed with
+// err should be tried again against half of window: only when the window was
+// estimated, the call itself overflowed, and the halvings left and the window
+// allow it. A summary call runs without compaction, so its overflow comes
+// back as the formatted error text rather than as a ContextOverflowError.
+func retryWithSmallerEstimate(ctx context.Context, estimated bool, halvings int, window int64, err error) bool {
+	if !estimated || err == nil || halvings >= maxEstimateHalvings || window/2 < minEstimatedWindow {
+		return false
+	}
+	if !modelerrors.IsContextOverflowError(err) && !strings.Contains(err.Error(), "exceeded the model's context window") {
+		return false
+	}
+	slog.WarnContext(ctx, "Summary overflowed the estimated context window; halving it",
+		"estimated_window", window, "next", window/2)
+	return true
+}
