+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (length-recovery.patch in github.com/blaktron/agentry-dockerimages).
+
+package latest
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestLengthRecoveryParses(t *testing.T) {
+	t.Parallel()
+
+	cfg, err := parse([]byte("version: \"16\"\nagents:\n  root:\n    model: anthropic/claude-sonnet-4-5\n    length_recovery: true\n"))
+	require.NoError(t, err)
+	assert.True(t, cfg.Agents[0].LengthRecovery)
+
+	cfg, err = parse([]byte("version: \"16\"\nagents:\n  root:\n    model: anthropic/claude-sonnet-4-5\n"))
+	require.NoError(t, err)
+	assert.False(t, cfg.Agents[0].LengthRecovery, "absent is off")
+}
