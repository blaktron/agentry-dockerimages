diff --git a/pkg/runtime/loop_nudge.go b/pkg/runtime/loop_nudge.go
new file mode 100644
index 000000000..54d2f1e9e
--- /dev/null
+++ b/pkg/runtime/loop_nudge.go
@@ -0,0 +1,95 @@
+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (loop-nudge.patch in github.com/blaktron/agentry-dockerimages).
+//
+// A streak of identical tool calls no longer ends the run. The agent is told,
+// once per streak, to reach its goal another way, and the run goes on under
+// its own limits (iterations, budget, the caller's timeout).
+
+package runtime
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+
+	"go.opentelemetry.io/otel/attribute"
+	"go.opentelemetry.io/otel/trace"
+
+	"github.com/docker/docker-agent/pkg/agent"
+	"github.com/docker/docker-agent/pkg/chat"
+	"github.com/docker/docker-agent/pkg/session"
+	"github.com/docker/docker-agent/pkg/tools"
+)
+
+// loopNudgeSourceKey names the nudge among the request's transient
+// instruction sources, beside the structured-output reminder.
+const loopNudgeSourceKey = "runtime/loop-nudge"
+
+// LoopNudgeWarningPrefix starts the Warning event emitted for every nudge, so
+// a caller reading the event stream can count them.
+const LoopNudgeWarningPrefix = "Loop nudge"
+
+// loopNudgeText is the message the model gets after a streak. It names the
+// tool and the count, never the arguments: they are the model's own words and
+// may carry content the run should not echo back as an instruction.
+func loopNudgeText(tool string, consecutive, earlier int) string {
+	text := fmt.Sprintf(
+		"You have made the same call to %s, with the same arguments, %d times in a row. "+
+			"Repeating it will not get a different result. "+
+			"Reach the same goal another way: use a different tool or different arguments, "+
+			"or check your checklist or plan for what is left. "+
+			"If the goal cannot be reached, say why, then move on to the next step or end the run: "+
+			"finish with what is done, or, if you have a tool for ending a run as blocked (such as end_blocked), call it.",
+		tool, consecutive)
+	switch earlier {
+	case 0:
+	case 1:
+		text += " You were told this once before in this run."
+	default:
+		text += fmt.Sprintf(" You were told this %d times before in this run.", earlier)
+	}
+	return text
+}
+
+// loopNudgeMessages returns the pending nudge as a one-element system-message
+// slice, or nil when none is due. Like the structured-output reminder it is
+// threaded into the next request only, never stored as a user message.
+func (ls *loopState) loopNudgeMessages() []chat.Message {
+	if ls.loopNudge == "" {
+		return nil
+	}
+	return []chat.Message{{Role: chat.MessageRoleSystem, Content: ls.loopNudge}}
+}
+
+// loopNudgeDelivered clears the pending nudge once a model call that carried
+// it has succeeded. A failed or retried call keeps it for the next attempt.
+func (ls *loopState) loopNudgeDelivered() {
+	ls.loopNudge = ""
+}
+
+// nudgeLoop handles a streak the loop detector reported: it queues the nudge
+// for the next request, records it on the session span, the log and the event
+// stream, and resets the detector so the next streak is counted afresh. It
+// never ends the run.
+func (r *LocalRuntime) nudgeLoop(ctx context.Context, sess *session.Session, a *agent.Agent, ls *loopState, calls []tools.ToolCall, sessionSpan trace.Span, events EventSink) {
+	toolName := "unknown"
+	if len(calls) > 0 {
+		toolName = calls[0].Function.Name
+	}
+	consecutive := ls.loopDetector.Consecutive()
+	earlier := ls.loopNudges
+	ls.loopNudges++
+	ls.loopNudge = loopNudgeText(toolName, consecutive, earlier)
+	ls.loopDetector.Reset()
+
+	slog.WarnContext(ctx, "Repetitive tool call loop detected; nudging the agent",
+		"agent", a.Name(), "tool", toolName,
+		"consecutive", consecutive, "nudge", ls.loopNudges, "session_id", sess.ID)
+	sessionSpan.SetAttributes(
+		attribute.Int("cagent.loop.consecutive_calls", consecutive),
+		attribute.Int("cagent.loop.nudges", ls.loopNudges),
+	)
+	events.Emit(Warning(fmt.Sprintf(
+		"%s %d: %d consecutive identical calls to %s; the agent was told to reach its goal another way.",
+		LoopNudgeWarningPrefix, ls.loopNudges, consecutive, toolName), a.Name()))
+}
diff --git a/pkg/runtime/loop_nudge_test.go b/pkg/runtime/loop_nudge_test.go
new file mode 100644
index 000000000..1f32f1ddf
--- /dev/null
+++ b/pkg/runtime/loop_nudge_test.go
@@ -0,0 +1,241 @@
+// This file is not part of upstream docker-agent: Agentry's build adds it
+// (loop-nudge.patch in github.com/blaktron/agentry-dockerimages).
+
+package runtime
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/docker/docker-agent/pkg/agent"
+	"github.com/docker/docker-agent/pkg/chat"
+	"github.com/docker/docker-agent/pkg/config/latest"
+	"github.com/docker/docker-agent/pkg/model/provider"
+	"github.com/docker/docker-agent/pkg/model/provider/base"
+	"github.com/docker/docker-agent/pkg/model/provider/options"
+	"github.com/docker/docker-agent/pkg/modelsdev"
+	"github.com/docker/docker-agent/pkg/session"
+	"github.com/docker/docker-agent/pkg/team"
+	"github.com/docker/docker-agent/pkg/tools"
+	"github.com/docker/docker-agent/pkg/tools/builtin/backgroundjobs"
+)
+
+// loopNudgeArgs carries a marker that must never reach the nudge text.
+const loopNudgeArgs = `{"path":"secret-marker-7f3a"}`
+
+// recordingQueueProvider answers from a queue of streams, like queueProvider,
+// and keeps every request's messages.
+type recordingQueueProvider struct {
+	mu       sync.Mutex
+	streams  []chat.MessageStream
+	requests [][]chat.Message
+}
+
+func (p *recordingQueueProvider) ID() modelsdev.ID { return modelsdev.ParseIDOrZero("test/mock-model") }
+
+func (p *recordingQueueProvider) CreateChatCompletionStream(_ context.Context, messages []chat.Message, _ []tools.Tool) (chat.MessageStream, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.requests = append(p.requests, append([]chat.Message(nil), messages...))
+	if len(p.streams) == 0 {
+		return &mockStream{}, nil
+	}
+	s := p.streams[0]
+	p.streams = p.streams[1:]
+	return s, nil
+}
+
+func (p *recordingQueueProvider) BaseConfig() base.Config {
+	cfg := base.Config{}
+	cfg.RebuildProvider = func(context.Context, *latest.ModelConfig, ...options.Opt) (provider.Provider, error) { return p, nil }
+	return cfg
+}
+
+func (p *recordingQueueProvider) MaxTokens() int { return 0 }
+
+// nudgesIn returns the loop nudges among a request's messages.
+func nudgesIn(messages []chat.Message) []string {
+	var out []string
+	for _, m := range messages {
+		if strings.HasPrefix(m.Content, "You have made the same call to ") {
+			out = append(out, m.Content)
+		}
+	}
+	return out
+}
+
+// toolCallStream is one model turn that calls tool with args.
+func toolCallStream(id, tool, args string) chat.MessageStream {
+	return newStreamBuilder().AddToolCallName(id, tool).AddToolCallArguments(id, args).AddToolCallStopWithUsage(2, 2).Build()
+}
+
+type loopNudgeRun struct {
+	prov      *recordingQueueProvider
+	sess      *session.Session
+	warnings  []string
+	loopErrs  int
+	responses int
+}
+
+// runLoopNudge runs one session against the given turns with a stub tool set
+// that answers every call to any of toolNames the same way.
+func runLoopNudge(t *testing.T, streams []chat.MessageStream, toolNames ...string) loopNudgeRun {
+	t.Helper()
+	var stubs []tools.Tool
+	for _, name := range toolNames {
+		stubs = append(stubs, tools.Tool{
+			Name: name,
+			Handler: func(context.Context, tools.ToolCall, tools.Runtime) (*tools.ToolCallResult, error) {
+				return tools.ResultSuccess("same answer"), nil
+			},
+		})
+	}
+	prov := &recordingQueueProvider{streams: streams}
+	root := agent.New("root", "looper", agent.WithModel(prov), agent.WithToolSets(newStubToolSet(nil, stubs, nil)))
+	rt, err := NewLocalRuntime(t.Context(), team.New(team.WithAgents(root)), WithSessionCompaction(false), WithModelStore(mockModelStore{}))
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, rt.Close()) })
+	sess := session.New(session.WithUserMessage("do the task"), session.WithToolsApproved(true))
+	sess.Title = "Unit Test"
+
+	run := loopNudgeRun{prov: prov, sess: sess}
+	for event := range rt.RunStream(t.Context(), sess) {
+		switch e := event.(type) {
+		case *WarningEvent:
+			if strings.HasPrefix(e.Message, LoopNudgeWarningPrefix) {
+				run.warnings = append(run.warnings, e.Message)
+			}
+		case *ErrorEvent:
+			if e.Code == ErrorCodeLoopDetected {
+				run.loopErrs++
+			}
+		case *ToolCallResponseEvent:
+			run.responses++
+		}
+	}
+	return run
+}
+
+func TestLoopNudge_StreakNudgesAndTheRunGoesOn(t *testing.T) {
+	t.Parallel()
+
+	var streams []chat.MessageStream
+	for i := range 5 {
+		streams = append(streams, toolCallStream(fmt.Sprintf("c%d", i), "read_file", loopNudgeArgs))
+	}
+	streams = append(streams,
+		toolCallStream("other", "list_dir", `{}`),
+		newStreamBuilder().AddContent("done another way").AddStopWithUsage(2, 2).Build())
+
+	run := runLoopNudge(t, streams, "read_file", "list_dir")
+
+	assert.Zero(t, run.loopErrs, "a streak never ends the run")
+	require.Len(t, run.warnings, 1)
+	assert.Equal(t, LoopNudgeWarningPrefix+" 1: 5 consecutive identical calls to read_file; the agent was told to reach its goal another way.", run.warnings[0])
+	assert.Equal(t, 6, run.responses)
+	assert.Equal(t, "done another way", run.sess.GetLastAssistantMessageContent())
+	assert.Empty(t, run.prov.streams)
+
+	require.Len(t, run.prov.requests, 7)
+	for i, req := range run.prov.requests {
+		switch i {
+		case 5:
+			nudges := nudgesIn(req)
+			require.Len(t, nudges, 1, "the request after the streak carries the nudge")
+			assert.Contains(t, nudges[0], "same call to read_file")
+			assert.Contains(t, nudges[0], "5 times in a row")
+			assert.Contains(t, nudges[0], "end_blocked")
+			assert.NotContains(t, nudges[0], "secret-marker-7f3a", "the nudge never quotes the arguments")
+			assert.NotContains(t, nudges[0], "before in this run")
+		default:
+			assert.Empty(t, nudgesIn(req), "request %d carries no nudge", i)
+		}
+	}
+	for _, m := range run.sess.GetAllMessages() {
+		assert.NotContains(t, m.Message.Content, "You have made the same call to", "the nudge is never stored")
+	}
+}
+
+func TestLoopNudge_EveryStreakIsNudgedWithTheCount(t *testing.T) {
+	t.Parallel()
+
+	var streams []chat.MessageStream
+	for i := range 15 {
+		streams = append(streams, toolCallStream(fmt.Sprintf("c%d", i), "read_file", loopNudgeArgs))
+	}
+	streams = append(streams, newStreamBuilder().AddContent("giving up: the file never changes").AddStopWithUsage(2, 2).Build())
+
+	run := runLoopNudge(t, streams, "read_file")
+
+	assert.Zero(t, run.loopErrs)
+	assert.Equal(t, []string{
+		LoopNudgeWarningPrefix + " 1: 5 consecutive identical calls to read_file; the agent was told to reach its goal another way.",
+		LoopNudgeWarningPrefix + " 2: 5 consecutive identical calls to read_file; the agent was told to reach its goal another way.",
+		LoopNudgeWarningPrefix + " 3: 5 consecutive identical calls to read_file; the agent was told to reach its goal another way.",
+	}, run.warnings)
+	assert.Equal(t, 15, run.responses)
+	assert.Equal(t, "giving up: the file never changes", run.sess.GetLastAssistantMessageContent())
+
+	require.Len(t, run.prov.requests, 16)
+	assert.NotContains(t, nudgesIn(run.prov.requests[5])[0], "before in this run")
+	assert.Contains(t, nudgesIn(run.prov.requests[10])[0], "You were told this once before in this run.")
+	assert.Contains(t, nudgesIn(run.prov.requests[15])[0], "You were told this 2 times before in this run.")
+	for _, i := range []int{4, 6, 9, 11, 14} {
+		assert.Empty(t, nudgesIn(run.prov.requests[i]), "request %d", i)
+	}
+}
+
+func TestLoopNudge_ARunThatNeverRepeatsIsUnchanged(t *testing.T) {
+	t.Parallel()
+
+	var streams []chat.MessageStream
+	for i := range 8 {
+		streams = append(streams, toolCallStream(fmt.Sprintf("c%d", i), "read_file", fmt.Sprintf(`{"path":"f%d"}`, i)))
+	}
+	streams = append(streams, newStreamBuilder().AddContent("read them all").AddStopWithUsage(2, 2).Build())
+
+	run := runLoopNudge(t, streams, "read_file")
+
+	assert.Zero(t, run.loopErrs)
+	assert.Empty(t, run.warnings)
+	assert.Equal(t, 8, run.responses)
+	for i, req := range run.prov.requests {
+		assert.Empty(t, nudgesIn(req), "request %d", i)
+	}
+}
+
+func TestLoopNudge_PollingToolsStayExempt(t *testing.T) {
+	t.Parallel()
+
+	var streams []chat.MessageStream
+	for i := range 8 {
+		streams = append(streams, toolCallStream(fmt.Sprintf("c%d", i), backgroundjobs.ToolNameViewBackgroundJob, `{"job_id":"j1"}`))
+	}
+	streams = append(streams, newStreamBuilder().AddContent("job finished").AddStopWithUsage(2, 2).Build())
+
+	run := runLoopNudge(t, streams, backgroundjobs.ToolNameViewBackgroundJob)
+
+	assert.Zero(t, run.loopErrs)
+	assert.Empty(t, run.warnings)
+	assert.Equal(t, 8, run.responses)
+}
+
+func TestLoopNudge_TextNamesToolAndCountOnly(t *testing.T) {
+	t.Parallel()
+
+	first := loopNudgeText("fetch", 5, 0)
+	assert.True(t, strings.HasPrefix(first, "You have made the same call to fetch, with the same arguments, 5 times in a row."))
+	assert.Contains(t, first, "another way")
+	assert.Contains(t, first, "checklist")
+	assert.Contains(t, first, "say why")
+	assert.NotContains(t, first, "before in this run")
+	assert.True(t, strings.HasSuffix(loopNudgeText("fetch", 5, 1), " You were told this once before in this run."))
+	assert.True(t, strings.HasSuffix(loopNudgeText("fetch", 7, 4), " You were told this 4 times before in this run."))
+	assert.Contains(t, loopNudgeText("fetch", 7, 4), "7 times in a row")
+}
