# The Codex harness image: OpenAI's Codex CLI release binary (musl, static),
# verified against OpenAI's keyless sigstore signature, on our Alpine mirror
# (agentry-dockerimages#53; agentry-notes plans/model-sign-ins.md §4.3, D5,
# D11). Nothing is compiled here: the binary is OpenAI's, unmodified.
#
# A bump is by hand (README, "The Codex image"): a new CODEX_VERSION, its tag's
# commit, and the SHA-256 of each architecture's release tarball. The build
# fails closed unless each tarball matches its SHA-256 and the binary inside
# it carries OpenAI's signature from rust-release.yml at CODEX_TAG and
# CODEX_COMMIT (verify.sh). Model sign-in conformance is re-recorded on each
# bump (agentry-cli, the codex container adapter's recordings).
CODEX_VERSION=0.162.0
CODEX_TAG=rust-v0.162.0
# The commit CODEX_TAG names (the tag object's target). The signing
# certificate carries it, and LICENSE and NOTICE are fetched at it.
CODEX_COMMIT=c1382380de69521303b416720a52f42d51af6248
CODEX_LICENSE=Apache-2.0
# SHA-256 of codex-<triple>.tar.gz, the release asset, per architecture.
CODEX_SHA256_AMD64=8daf67f6261161aa5939d8d42a516032d760406216779d7ce6040f242140ff73
CODEX_SHA256_ARM64=15162a9b59edf8e512b27414ec0b7db22e6424a1262b0eee8666643e0d295c2f
# SHA-256 of LICENSE and NOTICE at CODEX_COMMIT.
CODEX_LICENSE_SHA256=d17f227e4df5da1600391338865ce0f3055211760a36688f816941d58232d8dc
CODEX_NOTICE_SHA256=9d71575ecfd9a843fc1677b0efb08053c6ba9fd686a0de1a6f5382fd3c220915
# Built natively per architecture (PLATFORM=linux/amd64, PLATFORM=linux/arm64)
# and joined into one tag by scripts/build.sh --merge; the codex workflow does
# both, then signs the joined digest. The tag is the Codex version, the build
# date and the workflow's run number (0.162.0-2026.10.09.1), passed as
# IMAGE_TAG, and the workflow refuses a tag that exists, so a rebuild is a new
# tag and a new digest, never an overwrite.
IMAGE_NAME=agentry-codex
PLATFORMS=linux/amd64,linux/arm64
