# The base-image build-args of build/agentry-codex/Dockerfile, mapped to their
# upstream refs. scripts/build.sh replaces each with our digest-pinned mirror
# and refuses to build if the ref is not in images.tsv.
#
# ALPINE_IMAGE is the image's base and the fetch stage's: the runner image's
# own runtime base. The binary is static (musl), so the base is not linked
# in; it is there for `cat`, which the token route of the model sign-in
# runs (plan model-sign-ins.md D9), and a shell for the checks.
ALPINE_IMAGE=alpine:3.22
# COSIGN_IMAGE supplies the fetch stage's cosign, which verifies OpenAI's
# signature on the binary. Only its static binary is copied, and only into
# the fetch stage; nothing of it reaches the image.
COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v3.1.3
