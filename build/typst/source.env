# Typst, built from pinned upstream source (agentry-dockerimages#48; plan
# scratch-and-pdf-reports D23, D26), with the Noto fonts and the cmarker
# package fetched by SHA-256 (fetch.tsv), as a files-only image the runner
# image copies by digest.
#
# The upstream commit is patched: disable-package-downloads.patch removes the
# package downloader (README, "Building Typst from source"). Re-check the
# patch at every tag bump: it must still apply, the build's dependency check
# must still find no ureq, native-tls or OpenSSL, and
# scripts/check.sh --typst-image must still see an @preview import fail with
# "package downloads are disabled" and make no network call.
UPSTREAM_REPO=https://github.com/typst/typst
UPSTREAM_COMMIT=9dfd3a08500b7896045f907433cf7b4b02434fad
UPSTREAM_TAG=v0.15.1
UPSTREAM_LICENSE=Apache-2.0
# Built natively per architecture (PLATFORM=linux/amd64, PLATFORM=linux/arm64)
# and joined into one tag by scripts/build.sh --merge; the typst workflow does
# both, then signs the joined digest. The tag is the build date and the
# workflow's run number, passed as IMAGE_TAG, and the workflow refuses a tag
# that exists, so a rebuild is a new tag and a new digest, never an overwrite.
IMAGE_NAME=agentry-typst
PLATFORMS=linux/amd64,linux/arm64
