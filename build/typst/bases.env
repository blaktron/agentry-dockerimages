# The base-image build-arg of build/typst/Dockerfile, mapped to its upstream
# ref. scripts/build.sh replaces it with our digest-pinned mirror and refuses
# to build if the ref is not in images.tsv. Alpine 3.22, the runner image's
# own runtime base; the binary is static (musl), so the base is not linked in.
# Typst 0.15.1 needs Rust 1.92 or later.
RUST_IMAGE=rust:1.98.1-alpine3.22
