# Built from this directory, not from an upstream repository: the files image
# is Alpine with the decoders the runner's decode step runs, and nothing else
# (agentry-notes plans/file-handling.md §4, D3, D4; agentry-dockerimages#28).
#
# Built natively per architecture (PLATFORM=linux/amd64, PLATFORM=linux/arm64)
# and joined into one tag by scripts/build.sh --merge; the files workflow does
# both, then signs the joined digest. The tag is the build date and the
# workflow's run number, passed as IMAGE_TAG, and the workflow refuses a tag
# that exists, so a rebuild is a new tag and a new digest, never an overwrite.
IMAGE_NAME=agentry-files
PLATFORMS=linux/amd64,linux/arm64
