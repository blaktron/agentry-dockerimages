# The base-image build-arg of build/agentry-files/Dockerfile, mapped to its
# upstream ref. scripts/build.sh replaces it with our digest-pinned mirror and
# refuses to build if the ref is not in images.tsv. It is the runner image's
# own runtime base, so the decoders and the runner binary the CLI adds on top
# share one musl.
ALPINE_IMAGE=alpine:3.22
