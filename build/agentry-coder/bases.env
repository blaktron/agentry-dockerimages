# The base-image build-args of build/agentry-coder/Dockerfile, each mapped to
# its upstream ref. scripts/build.sh replaces each with our digest-pinned
# mirror and refuses to build if the ref is not in images.tsv.
#
# DEBIAN_IMAGE is the image's base: Debian 13 (trixie), from whose archive the
# toolchain's packages come. GO_IMAGE and NODE_IMAGE are build-time only: the
# Go distribution in /usr/local/go is the one file tree taken from GO_IMAGE,
# and Node's binary and its npm the only files taken from NODE_IMAGE, so no
# Debian golang or nodejs package is installed.
DEBIAN_IMAGE=debian:trixie-slim
GO_IMAGE=golang:1.27.3-trixie
NODE_IMAGE=node:26-trixie-slim
