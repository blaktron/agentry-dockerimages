# The Coding agent's toolchain image: Debian 13's build tools and Python, Go
# and Node with npm, on our debian:trixie-slim mirror. Nothing is compiled
# here.
#
# Every Debian package comes from snapshot.debian.org at DEBIAN_SNAPSHOT,
# whose three signed indexes are held to their SHA-256, so a rebuild of the
# same commit installs the same versions (install.sh). Go is the Go project's
# release in GO_IMAGE (bases.env), held to GO_VERSION; Node and npm are
# NODE_IMAGE's, held to NODE_MAJOR.
#
# PACKAGES is the toolchain, installed without recommends; the README's
# "agentry-coder" section lists it, and scripts/check.sh holds it to the
# tools the image promises and refuses a package that would hand a run a
# privilege or a way around the runner (sudo, an SSH client or server).
#
# A bump is by hand (README, "agentry-coder"): a new Go is a new golang
# trixie tag in images.tsv and GO_VERSION; a new snapshot is a timestamp and
# the SHA-256 of each suite's InRelease at it.
GO_VERSION=1.27.3
NODE_MAJOR=24
DEBIAN_SNAPSHOT=20261022T000000Z
# SHA-256 of dists/<suite>/InRelease at DEBIAN_SNAPSHOT (debian-security for
# trixie-security).
DEBIAN_INDEX_SHA256_TRIXIE=0584fba32e13e0ab8285fb16c27adea1ec03a73669c18702821094fd6ca86675
DEBIAN_INDEX_SHA256_TRIXIE_UPDATES=546faff09befe9aff38c74cf8c21ced39aba9a90555f919f6e2f9e5368313922
DEBIAN_INDEX_SHA256_TRIXIE_SECURITY=ebc037ef479e20ff279abbe69854c12d14d6dd384c623555610d2bfb7bb90187
PACKAGES="ca-certificates curl git build-essential make cmake pkg-config python3 python3-dev python3-pip python3-venv unzip zip xz-utils bzip2 patch file jq procps less"
# Built natively per architecture (PLATFORM=linux/amd64, PLATFORM=linux/arm64)
# and joined into one tag by scripts/build.sh --merge; the coder workflow
# does both, then signs the joined digest. The tag is the build date and the
# workflow's run number, passed as IMAGE_TAG, and the workflow refuses a tag
# that exists, so a rebuild is a new tag and a new digest, never an overwrite.
IMAGE_NAME=agentry-coder
PLATFORMS=linux/amd64,linux/arm64
